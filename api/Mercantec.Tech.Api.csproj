<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Notebooks/default-template.json" LogicalName="Mercantec.Tech.Api.DefaultNotebookTemplate.json" />
    <EmbeddedResource Include="KnowledgeChecks/ControlFlowPilot.json" LogicalName="Mercantec.Tech.Api.ControlFlowPilot.json" />
    <Content Remove="KnowledgeChecks/LegacyTemplates.json" />
    <EmbeddedResource Include="KnowledgeChecks/LegacyTemplates.json" LogicalName="Mercantec.Tech.Api.LegacyKnowledgeChecks.json" />
    <Content Remove="KnowledgeChecks/CharacterTemplates.json" />
    <EmbeddedResource Include="KnowledgeChecks/CharacterTemplates.json" LogicalName="Mercantec.Tech.Api.CharacterKnowledgeChecks.json" />
    <EmbeddedResource Include="Emojis/Standard/*.png" LogicalName="standard-emojis/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../web/wwwroot/images/characters/**/reactions/*.webp"
                      LogicalName="cover-art/images/characters/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="../web/wwwroot/images/valgfag/*.webp"
                      LogicalName="cover-art/images/valgfag/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../extensions/lup/assets/fonts/space-grotesk-variable.ttf"
                      LogicalName="cover-font/space-grotesk.ttf" />
    <EmbeddedResource Include="../extensions/lup/assets/licenses/SPACE-GROTESK-OFL.txt"
                      LogicalName="cover-font/SPACE-GROTESK-OFL.txt" />
    <EmbeddedResource Include="Updates/Images/*.webp" LogicalName="platform-updates/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Updates/coverage.json" LogicalName="platform-updates/coverage.json" />
    <EmbeddedResource Include="Updates/Notes/*.json" LogicalName="platform-updates/notes/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Wordle/Data/answers.json" LogicalName="wordle/answers.json" />
    <EmbeddedResource Include="Wordle/Data/guesses.txt" LogicalName="wordle/guesses.txt" />
    <EmbeddedResource Include="Storage/CharacterOriginals/manifest.json" LogicalName="character-originals/manifest.json" />
    <EmbeddedResource Include="Integrations\OpenAI\editor-block-prompt.txt">
      <LogicalName>Mercantec.Tech.Api.EditorBlockPrompt.txt</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- Compile the existing editorial metadata directly; frontend and references share one source. -->
    <Compile Include="../web/Courses/CourseTemplateCatalog.cs" Link="References/Catalog/CourseTemplateCatalog.cs" />
    <Compile Include="../web/Public/PublicCatalog.cs" Link="References/Catalog/PublicCatalog.cs" />
    <Compile Include="../web/Public/PublicGlobalSearch.cs" Link="Search/PublicGlobalSearch.cs" />
    <Compile Include="../web/Games/GamesCatalog.cs" Link="Search/GamesCatalog.cs" />
    <Compile Include="../web/Demo/DemoCatalog.cs" Link="References/Catalog/DemoCatalog.cs" />
    <Compile Include="../web/Demo/LearningContent.cs" Link="References/Catalog/LearningContent.cs" />
    <Compile Include="../web/Characters/CharacterCatalog.cs" Link="References/Catalog/CharacterCatalog.cs" />
    <Compile Include="../web/Characters/CharacterHomes.cs" Link="References/Catalog/CharacterHomes.cs" />
    <Compile Include="../web/Characters/CharacterCollaborations.cs" Link="References/Catalog/CharacterCollaborations.cs" />
    <Compile Include="../web/Characters/VatsonEmojiCatalog.cs" Link="References/Catalog/VatsonEmojiCatalog.cs" />
    <Compile Include="../web/Characters/WhaleMaterials.cs" Link="References/Catalog/WhaleMaterials.cs" />
    <Compile Include="../web/Characters/DuckTeachingMaterials.cs" Link="References/Catalog/DuckTeachingMaterials.cs" />
    <Compile Include="../web/Characters/DuckMotionMaterials.cs" Link="References/Catalog/DuckMotionMaterials.cs" />
    <Compile Include="../web/Characters/BeeTeachingMaterials.cs" Link="References/Catalog/BeeTeachingMaterials.cs" />
    <Compile Include="../web/Characters/BeeMotionMaterials.cs" Link="References/Catalog/BeeMotionMaterials.cs" />
    <Compile Include="../web/Characters/BatTeachingMaterials.cs" Link="References/Catalog/BatTeachingMaterials.cs" />
    <Compile Include="../web/Characters/BatMotionMaterials.cs" Link="References/Catalog/BatMotionMaterials.cs" />
    <Compile Include="../web/Characters/BilboTeachingMaterials.cs" Link="References/Catalog/BilboTeachingMaterials.cs" />
    <Compile Include="../web/Characters/BilboMotionMaterials.cs" Link="References/Catalog/BilboMotionMaterials.cs" />
    <Compile Include="../web/Characters/GitmejsenMaterials.cs" Link="References/Catalog/GitmejsenMaterials.cs" />
    <Compile Include="../web/Characters/KarlaMaterials.cs" Link="References/Catalog/KarlaMaterials.cs" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.4.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <ProjectReference Include="../shared/Mercantec.Tech.Contracts.csproj" />
    <PackageReference Include="AngleSharp" Version="1.10.0" />
    <PackageReference Include="SkiaSharp" Version="4.157.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.157.0" />
    <PackageReference Include="AWSSDK.S3" Version="3.7.511.8" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>

</Project>
