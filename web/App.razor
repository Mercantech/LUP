@inject AuthService Auth
@inject NavigationManager Nav
@implements IDisposable

<HeadContent>
    <link rel="icon" type="image/svg+xml" sizes="any" href="images/branding/pixel-lup.svg" data-lup-brand-icon="images/branding/pixel-lup.svg" />
</HeadContent>

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
        <Found Context="routeData">
            @if (!Auth.IsInitialized)
            {
                <LayoutView Layout="@typeof(MainLayout)">
                    <LupLoading Message="@(_restoring ? "Genopretter login…" : "Indlæser…")" />
                </LayoutView>
            }
            else if (!Auth.IsAuthenticated && !PublicPageAccess.Allows(Nav.ToBaseRelativePath(Nav.Uri))
                && !ExtensionEmojiDraft.IsImportPath(Nav.ToBaseRelativePath(Nav.Uri)))
            {
                @if (Auth.SessionRecoveryPending)
                {
                    <LayoutView Layout="@typeof(MainLayout)">
                        <PageTitle>Genopret login · LUP</PageTitle>
                        <header class="page-title"><div><h1>Genopret login</h1></div></header>
                        <p role="status">@(_restoring ? "Genopretter login…" : "Forbindelsen til Mercantec Auth er midlertidigt utilgængelig.")</p>
                        <button type="button" class="action" @onclick="RestoreSessionAsync" disabled="@_restoring">Prøv igen</button>
                    </LayoutView>
                }
                else
                {
                    <LayoutView Layout="@typeof(MainLayout)"><PageTitle>Log ind · LUP</PageTitle><header class="page-title"><div><h1>Log ind</h1><p>Denne side kræver login.</p></div></header><a class="action" href="@Auth.LoginPath()">Log ind</a></LayoutView>
                }
            }
            else
            {
                <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)"/>
            }
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
    </Router>
</CascadingAuthenticationState>

@code {
    private bool _initialized;
    private bool _restoring;
    protected override void OnInitialized() => Auth.AuthStateChanged += OnAuth;
    private void OnAuth() => InvokeAsync(StateHasChanged);
    public void Dispose() => Auth.AuthStateChanged -= OnAuth;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialized)
            return;

        _initialized = true;
        await RestoreSessionAsync();
        StateHasChanged();
    }

    private async Task RestoreSessionAsync()
    {
        if (_restoring) return;
        _restoring = true;
        StateHasChanged();
        try
        {
            await Auth.InitializeAsync();
        }
        finally
        {
            _restoring = false;
        }
    }
}
