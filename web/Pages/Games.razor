@page "/games"
@using Mercantec.Tech.Web.Games

<PageTitle>Spil · LUP</PageTitle>

<div class="games-catalog">
    <h1>Spil</h1>
    <article class="arena-feature" aria-labelledby="arena-feature-title">
        <img class="arena-feature-art" src="/assets/arena/v2/menu-keyart.webp" alt="" fetchpriority="high" />
        <div class="arena-feature-copy">
            <h2 id="arena-feature-title">LUP Arena</h2>
            <p>Vælg din avatar, træn mod computeren, eller kæmp online med op til tre venner.</p>
            <a class="arena-feature-play" href="/games/arena">Spil LUP Arena</a>
        </div>
    </article>

    <section class="daily-games" aria-labelledby="daily-games-title">
        <h2 id="daily-games-title">Daglige spil</h2>
        <div class="daily-games-grid">
            <article class="daily-game">
                <div class="daily-game-preview" aria-hidden="true"><span>O</span><span>R</span><span>D</span></div>
                <h3>Dagens Wordle</h3>
                <p>Gæt et ord på fem bogstaver med dagens LUP-vært.</p>
                <a class="daily-game-play" href="@GamesCatalog.WordlePath">Spil dagens Wordle <span aria-hidden="true">→</span></a>
            </article>
            <article class="daily-game daily-game-word">
                <div class="daily-game-preview" aria-hidden="true"><span>A</span><span>Å</span><span>?</span></div>
                <h3>Dagens ord</h3>
                <p>Brug karakterens ledetråde til at gætte et fagbegreb på tre forsøg.</p>
                <a class="daily-game-play" href="@GamesCatalog.DailyWordPath">Spil Dagens ord <span aria-hidden="true">→</span></a>
            </article>
            <article class="daily-game daily-game-numbers">
                <div class="daily-game-preview" aria-hidden="true"><span>5</span><span>+</span><span>7</span></div>
                <h3>Taljagt</h3>
                <p>Byg dagens måltal med Bilbo Backend og Kamæleonen.</p>
                <a class="daily-game-play" href="@GamesCatalog.TaljagtPath">Spil Taljagt <span aria-hidden="true">→</span></a>
            </article>
        </div>
    </section>

    <section class="classic-games" aria-labelledby="classic-games-title">
        <h2 id="classic-games-title">Klassikere</h2>
        <div class="classic-games-grid">
            @foreach (var game in GamesCatalog.Classics)
            {
                <article class="classic-game">
                    <img src="@game.ArtworkUrl" alt="" loading="lazy" width="1024" height="576" />
                    <div class="classic-game-copy">
                        <h3><a href="@game.Path">@game.Name</a></h3>
                        <p>@game.Description</p>
                    </div>
                </article>
            }
        </div>
        <nav class="games-resources" aria-label="Vejledning og turnering">
            <a href="@GamesCatalog.GuidePath">Arduino Oplà-guide</a>
            <a href="/games/manual">Spilmanualer</a>
            <a href="/games/bracket">Turnering</a>
            <a href="/games/status">Spilstatus</a>
        </nav>
    </section>
</div>
