@page "/teacher"
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject ViewAsStudentContext ViewAs
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Underviser</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else if (Auth.IsAuthenticated && Redirect.ShowsTeacherChrome)
{
    <header class="page-title">
        <div>
            <h1>Goddag@(string.IsNullOrEmpty(Auth.DisplayName) ? "" : $", {Auth.DisplayName.Split(' ')[0]}")</h1>
            <p>Dit overblik over undervisning, elever og det næste, der skal ske.</p>
        </div>
    </header>
    <FavoriteShortcutsPanel />
    <section aria-labelledby="teacher-home-calendar">
        <div class="headrow">
            <h2 id="teacher-home-calendar">Min kalender</h2>
            <a href="/teacher/planner">Åbn kalenderen</a>
        </div>
        <PersonalCalendar Teacher="true" />
    </section>
}

@code {
    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnAuth;
        ViewAs.Changed += OnAuth;
        EnsureAccess();
    }

    private void EnsureAccess()
    {
        if (!Auth.IsInitialized)
            return;

        if (!Auth.IsAuthenticated)
        {
            Nav.NavigateTo(Auth.LoginPath());
            return;
        }

        if (ViewAs.IsActive)
        {
            Nav.NavigateTo("/student");
            return;
        }

        if (Redirect.CurrentAppRole() != AppRole.Underviser)
            Nav.NavigateTo(Redirect.PostLoginPath());
    }

    private void OnAuth() => InvokeAsync(() =>
    {
        EnsureAccess();
        StateHasChanged();
    });

    public void Dispose()
    {
        Auth.AuthStateChanged -= OnAuth;
        ViewAs.Changed -= OnAuth;
    }
}
