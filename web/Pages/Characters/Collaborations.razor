@page "/characters/collaborations"
@using Mercantec.Tech.Web.Characters
@inject NavigationManager Nav
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>Når fagene mødes · Karakterer · LUP</PageTitle>
<div class="characters collaboration-page">
    <nav class="character-breadcrumbs" aria-label="Brødkrumme">
        <a href="/library?category=characters">Oversigt</a><span aria-hidden="true">/</span>
        <a href="/characters">Karakterer</a><span aria-hidden="true">/</span>
        <span aria-current="page">Fællesbilleder</span>
    </nav>

    <header class="collaboration-intro">
        <h1 id="collaboration-gallery-title">Når fagene mødes</h1>
        <p>Se karaktererne arbejde sammen om alt fra SQL til spiludvikling.</p>
    </header>

    <section class="character-collaborations collaboration-collection" aria-labelledby="collaboration-gallery-title">
        <div class="collaboration-toolbar">
            <label for="collaboration-character">Filtrér efter karakter</label>
            <select id="collaboration-character" @bind="_selectedSlug" @bind:after="FilterByCharacter">
                <option value="">Alle karakterer</option>
                @foreach (var character in Participants)
                {
                    <option value="@character.Slug">@character.Name</option>
                }
            </select>
            <span role="status">@_visibleScenes.Count @(_visibleScenes.Count == 1 ? "billede" : "billeder")</span>
        </div>

        <div class="character-gallery-grid">
            @foreach (var scene in _visibleScenes)
            {
                <CharacterCollaborationCard Scene="@scene" @key="scene.Id" />
            }
        </div>
    </section>
</div>

@code {
    private static readonly CharacterProfile[] Participants = CharacterCatalog.All
        .Where(character => character.Collaborations.Count > 0)
        .OrderBy(character => character.Name, StringComparer.CurrentCultureIgnoreCase)
        .ToArray();

    private IReadOnlyList<CharacterCollaboration> _visibleScenes = CharacterCollaborations.All;
    private string _selectedSlug = "";
    private (string Id, string Location)? _pendingSection;

    private void FilterByCharacter() => _visibleScenes = _selectedSlug.Length == 0
        ? CharacterCollaborations.All
        : CharacterCollaborations.For(_selectedSlug);

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        QueueSection(Nav.Uri);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(() =>
    {
        if (args.Location == Nav.Uri && QueueSection(args.Location)) StateHasChanged();
    });

    private bool QueueSection(string location)
    {
        var uri = Nav.ToAbsoluteUri(location);
        if (!string.Equals(uri.AbsolutePath.TrimEnd('/'), CharacterCollaborations.Path, StringComparison.OrdinalIgnoreCase))
            return false;

        var id = uri.Fragment.TrimStart('#');
        if (!CharacterCollaborations.All.Any(scene => scene.Anchor == id)) return false;
        if (!_visibleScenes.Any(scene => scene.Anchor == id))
        {
            _selectedSlug = "";
            FilterByCharacter();
        }

        _pendingSection = (id, location);
        return true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingSection is not { } section) return;
        _pendingSection = null;
        await Js.InvokeVoidAsync("lupCharacterUi.scrollToSection", section.Id, section.Location);
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
