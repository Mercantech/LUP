<section class="binding-lab" aria-labelledby="@SectionId">
    <div class="binding-controls controls">
        <h2 id="@SectionId">Ibens lysdæmper</h2>
        <p>Træk i skyderen, og brug derefter tænd/sluk-knappen. Se, hvilken vej værdien bevæger sig.</p>
        <div class="binding-control-row">
            <label for="iben-brightness">Lysstyrke</label>
            <output for="iben-brightness">@brightness %</output>
        </div>
        <input id="iben-brightness" type="range" min="0" max="100" @bind="brightness" @bind:event="oninput" @bind:after="OnSliderChanged" />
        <div class="binding-actions">
            <button type="button" class="secondary" @onclick="ToggleLight">@(brightness > 0 ? "Sluk lanternen" : "Tænd lanternen")</button>
            <button type="button" class="secondary" @onclick="Reset">Nulstil</button>
        </div>
    </div>
    <div class="lantern" aria-hidden="true">
        <div class="binding-light" style="opacity: @(brightness)%"></div>
        <img src="/images/characters/iben/lantern.webp" alt="" width="220" height="220"
             style="filter: brightness(@(24 + brightness * 76 / 100)%) saturate(@(35 + brightness * 65 / 100)%)" />
    </div>
    <div class="binding-trace">
        <p><strong>@Direction</strong></p>
        <code>brightness = @brightness</code>
    </div>
    <details class="binding-code">
        <summary><UiIcon Name="chevron" /><span>Se Razor-koden</span></summary>
        <div class="binding-code-content">
            <dl class="binding-code-guide">
                <div>
                    <dt><code>@@bind</code></dt>
                    <dd>Skyderen læser fra og skriver til det samme C#-felt, <code>brightness</code>.</dd>
                </div>
                <div>
                    <dt><code>@@bind:event="oninput"</code></dt>
                    <dd>Blazor opdaterer feltet, mens du trækker. Procenttallet læser den samme værdi.</dd>
                </div>
                <div>
                    <dt><code>@@onclick</code></dt>
                    <dd>Knappen kalder <code>ToggleLight</code>. Når metoden ændrer feltet, følger skyderen med.</dd>
                </div>
            </dl>
            <CourseCodeBlock Code="@Example" Language="razor" />
        </div>
    </details>
</section>

@code {
    public const string SectionId = "iben-binding";
    private const int InitialBrightness = 65;
    private int brightness = InitialBrightness;
    private string Direction { get; set; } = "Startværdi fra C#";

    private void OnSliderChanged() => Direction = "Skyder → C#";

    private void ToggleLight()
    {
        brightness = brightness > 0 ? 0 : 100;
        Direction = "C# → Skyder";
    }

    private void Reset()
    {
        brightness = InitialBrightness;
        Direction = "Startværdi fra C#";
    }

    private const string Example = """
        <label for="lys">Lysstyrke</label>
        <input id="lys" type="range" min="0" max="100"
               @bind="brightness" @bind:event="oninput" />
        <output for="lys">@brightness %</output>
        <button type="button" @onclick="ToggleLight">
            @(brightness > 0 ? "Sluk lanternen" : "Tænd lanternen")
        </button>

        @code {
            private int brightness = 65;
            private void ToggleLight() => brightness = brightness > 0 ? 0 : 100;
        }
        """;
}
