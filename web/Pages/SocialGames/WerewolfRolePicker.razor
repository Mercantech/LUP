<fieldset class="sg-fieldset sg-role-picker" disabled="@Busy">
    <legend>Specialkort</legend>
    @if (Editable)
    {
        <p class="sg-role-tally">@Selected.Length af @SocialRoles.Specials.Length valgt</p>
    }
    <div class="sg-roles">
        @foreach (var role in SocialRoles.Specials)
        {
            if (Editable)
            {
                <label @key="role" class="sg-role-card sg-role-option" data-selected="@(Selected.Contains(role) ? "true" : "false")">
                    <input type="checkbox" value="@role" aria-label="@SocialRoles.Names[role]" aria-describedby="@DescriptionId(role)"
                           @bind:get="Selected.Contains(role)" @bind:set="@((bool enabled) => ToggleAsync(role, enabled))" />
                    <WerewolfRoleFace Role="@role" DescriptionId="@DescriptionId(role)" />
                </label>
            }
            else if (ShowAll || Selected.Contains(role))
            {
                <div @key="role" class="sg-role-card">
                    <WerewolfRoleFace Role="@role" />
                </div>
            }
        }
    </div>
    @if (!Editable && !ShowAll && Selected.Length == 0)
    {
        <p class="sg-hint">Ingen specialkort i denne runde.</p>
    }
</fieldset>

@code {
    [Parameter, EditorRequired] public string[] Selected { get; set; } = [];
    [Parameter] public bool Editable { get; set; }
    [Parameter] public bool ShowAll { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<string[]> SelectionChanged { get; set; }

    private readonly string _descriptionPrefix = $"sg-role-{Guid.NewGuid():N}";

    private string DescriptionId(string role) => $"{_descriptionPrefix}-{role}";

    private Task ToggleAsync(string role, bool enabled)
    {
        if (Busy || !Editable) return Task.CompletedTask;
        var next = Selected.ToHashSet();
        if (enabled) next.Add(role); else next.Remove(role);
        return SelectionChanged.InvokeAsync(SocialRoles.Specials.Where(next.Contains).ToArray());
    }
}
