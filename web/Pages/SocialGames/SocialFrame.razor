<HeadContent><link rel="stylesheet" href="/css/lup-social-games.css" /></HeadContent>

<div class="social-play">
    <nav aria-label="Brødkrumme" class="sg-crumbs">
        <a href="/games">Spil</a><UiIcon Name="chevron" />
        @if (IsHub)
        {
            <span aria-current="page">Sociale spil</span>
        }
        else
        {
            <a href="/games/social">Sociale spil</a><UiIcon Name="chevron" /><span aria-current="page">Werewolf</span>
        }
    </nav>
    @ChildContent
</div>

@code {
    [Parameter] public bool IsHub { get; set; }
    [Parameter, EditorRequired] public RenderFragment? ChildContent { get; set; }
}
