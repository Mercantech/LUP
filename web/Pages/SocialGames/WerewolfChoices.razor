@if (Game.Actions.Length > 0)
{
    @if (Game.Deadline is DateTimeOffset deadline)
    {
        <p class="sg-hint">Tid tilbage <strong>@(Math.Max(0, (int)Math.Ceiling((deadline - DateTimeOffset.UtcNow).TotalSeconds))) sek.</strong></p>
    }
    @foreach (var action in Game.Actions)
    {
        var selected = Values(action.Key);
        @if (action.Options.Length == 0)
        {
            <button @key="action.Key" class="sg-button" type="button" disabled="@Busy" @onclick="@(() => ApplyAsync(action))">@action.Label</button>
        }
        else
        {
            <fieldset @key="action.Key" class="sg-action sg-fieldset" disabled="@Busy">
                <legend>@action.Label</legend>
                @if (action.MinChoices > 1) { <p class="sg-hint">Vælg @action.MinChoices forskellige muligheder.</p> }
                <div class="sg-options">
                    @foreach (var option in action.Options)
                    {
                        <label @key="option.Value">
                            <input type="@(action.MaxChoices == 1 ? "radio" : "checkbox")" name="@($"sg-{Game.PhaseId}-{action.Key}")"
                                checked="@selected.Contains(option.Value)" @onchange="@(e => Choose(action, option.Value, e))"
                                disabled="@(!selected.Contains(option.Value) && action.MaxChoices > 1 && selected.Count >= action.MaxChoices)" />
                            @option.Label
                        </label>
                    }
                </div>
                <button type="button" class="sg-button primary" disabled="@(selected.Count < action.MinChoices || selected.Count > action.MaxChoices || Busy)" @onclick="@(() => ApplyAsync(action))">Bekræft valg</button>
            </fieldset>
        }
    }
}

@code {
    [Parameter, EditorRequired] public WerewolfView Game { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<SocialGameActionRequest> Submit { get; set; }
    private readonly Dictionary<string, HashSet<string>> _selected = [];
    private int? _phase;

    protected override void OnParametersSet()
    {
        if (_phase != Game.PhaseId) { _phase = Game.PhaseId; _selected.Clear(); }
    }
    private HashSet<string> Values(string key)
    {
        if (!_selected.TryGetValue(key, out var values)) _selected[key] = values = [];
        return values;
    }
    private void Choose(WerewolfAction action, string value, ChangeEventArgs change)
    {
        var selected = Values(action.Key);
        if (action.MaxChoices == 1) { selected.Clear(); selected.Add(value); }
        else if (change.Value is true) selected.Add(value);
        else selected.Remove(value);
    }
    private Task ApplyAsync(WerewolfAction action) =>
        Submit.InvokeAsync(new(Game.PhaseId, action.Key, Values(action.Key).ToArray()));
}
