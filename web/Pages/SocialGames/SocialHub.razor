@page "/games/social"
@inject NavigationManager Nav

<PageTitle>@Lang.T("Sociale spil", "Social games") · LUP</PageTitle>
<h1>@Lang.T("Sociale spil", "Social games")</h1>
<WerewolfCover>
    <h2>Werewolf</h2>
    <p>@Lang.T("Ulvene gemmer sig blandt jer. Hvem stoler landsbyen på, når solen står op?", "The wolves are hiding among you. Who will the village trust at sunrise?")</p>
    <div class="sg-cover-actions">
        <a class="sg-button primary" href="/games/social/werewolf">@Lang.T("Spil Werewolf", "Play Werewolf") <UiIcon Name="arrow" /></a>
        <a class="sg-cover-link" href="/games/social/werewolf/cards"><UiIcon Name="book" /> @Lang.T("Kortgalleri", "Card gallery")</a>
    </div>
</WerewolfCover>
<section class="sg-code-entry" aria-labelledby="sg-have-code">
    <div>
        <h2 id="sg-have-code">@Lang.T("Har du en lobbykode?", "Have a lobby code?")</h2>
        <p>@Lang.T("Deltag med dit LUP-login eller som gæst.", "Join with your LUP account or as a guest.")</p>
    </div>
    <form @onsubmit="OpenRoom" @onsubmit:preventDefault>
        <label for="sg-room-code">@Lang.T("Lobbykode", "Lobby code")</label>
        <div class="sg-inline">
            <input id="sg-room-code" class="sg-code-input" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" placeholder="@Lang.T("6 cifre", "6 digits")" autocomplete="off" spellcheck="false" @bind="_code" @bind:event="oninput" required />
            <button class="sg-button" type="submit" disabled="@(!HasCode)">@Lang.T("Deltag", "Join")</button>
        </div>
    </form>
</section>

@code {
    [CascadingParameter] public SocialGameLanguage Lang { get; set; } = new();
    private string _code = "";
    private bool HasCode => _code.Length == 6 && _code.All(char.IsAsciiDigit);
    private void OpenRoom()
    {
        if (HasCode) Nav.NavigateTo($"/games/social/{_code}");
    }
}
