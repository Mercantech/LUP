@page "/games/social/{Code}"
@inject AuthService Auth
@inject NavigationManager Nav
@inject SocialGamesClient Client
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>Werewolf @(RoomState?.Code ?? Code) · LUP</PageTitle>
@if (RoomState is null)
{
    <div class="sg-setup">
        <div class="sg-cover"><img src="/images/social-games/werewolf.webp" alt="" width="1200" height="800" /></div>
        <section class="sg-setup-copy">
            <h1>@Lang.T("Deltag i Werewolf", "Join Werewolf")</h1>
            @if (_loading)
            {
                <p role="status">@Lang.T("Åbner lobbyen…", "Opening lobby…")</p>
            }
            else if (_canJoin)
            {
                <p>Lobby <strong class="sg-code">@Code</strong></p>
                <form class="sg-stack" @onsubmit="JoinAsync" @onsubmit:preventDefault>
                    @if (!Auth.IsAuthenticated)
                    {
                        <label for="sg-nickname">@Lang.T("Dit kaldenavn", "Your nickname")</label>
                        <input id="sg-nickname" @bind="_nickname" @bind:event="oninput" autocomplete="nickname" maxlength="30" required />
                    }
                    <button type="submit" class="sg-button primary" disabled="@(_busy || (!Auth.IsAuthenticated && string.IsNullOrWhiteSpace(_nickname)))">
                        @(Auth.IsAuthenticated ? Lang.T("Deltag med min LUP-profil", "Join with my LUP account") : Lang.T("Deltag som gæst", "Join as a guest"))
                    </button>
                    @if (!Auth.IsAuthenticated)
                    {
                        <a class="sg-plain" href="@Auth.LoginPath()">@Lang.T("Deltag med LUP-login", "Join with a LUP account")</a>
                    }
                </form>
            }
            @if (InvalidCode) { <p class="sg-error" role="alert">@Lang.T("Lobbykoden skal bestå af seks cifre.", "The lobby code must be six digits.")</p> }
            else if (_error is not null) { <p class="sg-error" role="alert">@Lang.Error(_error)</p> }
            @if (!_loading && !_canJoin)
            {
                <div class="sg-inline">
                    @if (_canRetry) { <button class="sg-button" @onclick="LoadRoomAsync">@Lang.T("Prøv igen", "Try again")</button> }
                    <a class="sg-plain" href="/games/social">@Lang.T("Indtast en anden kode", "Enter a different code")</a>
                </div>
            }
        </section>
    </div>
}
else
{
    var room = RoomState;
    @if (room.Game is null)
    {
        <WerewolfCover>
            <h1>Werewolf</h1>
            <p class="sg-lobby-code">Lobby <strong class="sg-code">@room.Code</strong></p>
            <div class="sg-cover-actions">
                <button type="button" class="sg-button primary" @onclick="CopyAsync">@(_copied ? Lang.T("Link kopieret", "Link copied") : Lang.T("Kopiér invitationslink", "Copy invite link"))</button>
                @if (room.IsHost)
                {
                    <button type="button" class="sg-button sg-cover-secondary" disabled="@(_busy || room.StartProblem is not null)" aria-describedby="@(room.StartProblem is null ? null : "sg-start-hint")" @onclick="StartAsync">
                        @Lang.T("Start spillet", "Start game") <UiIcon Name="arrow" />
                    </button>
                }
            </div>
            @if (room.IsHost && room.StartProblem is { } reason) { <p id="sg-start-hint" class="sg-cover-note">@Lang.Server(reason)</p> }
            @if (!room.IsHost) { <p class="sg-cover-note" role="status">@Lang.T("Værten starter spillet, når landsbyen er klar.", "The host will start the game when the village is ready.")</p> }
        </WerewolfCover>
    }
    else
    {
        <header class="sg-room-heading">
            <h1>Werewolf</h1>
            <p>@Lang.T("Spil", "Game") <strong class="sg-code">@room.Code</strong></p>
        </header>
    }
    @if (_manualLink) {
        <label for="sg-share-url">@Lang.T("Kopiér dette link", "Copy this link")</label>
        <input id="sg-share-url" type="url" readonly value="@InviteUrl" />
    }
    @if (_connectionLost) { <p class="sg-error" role="status">@Lang.T("Forbindelsen er afbrudt. Forsøger at hente spillet igen…", "Connection lost. Reconnecting to the game…")</p> }
    @if (_error is not null) { <p class="sg-error" role="alert">@Lang.Error(_error)</p> }
    <div class="sg-room-grid">
        <div class="sg-stack sg-main">
            @if (room.Game is { } game)
            {
                <WerewolfRound Room="room" Busy="@_busy" Submit="ActAsync" />
            }
            else
            {
                <section class="sg-deck-panel" aria-labelledby="sg-deck-title">
                    <div class="sg-section-heading">
                        <h2 id="sg-deck-title">@Lang.T("Kortfordeling", "Card distribution")</h2>
                        <a href="/games/social/werewolf/cards" target="_blank" rel="noopener" class="sg-plain">@Lang.T("Kortgalleri", "Card gallery") <UiIcon Name="external" /></a>
                    </div>
                    <WerewolfDeck Room="room" Busy="@_busy" Change="ChangeSettingsAsync" />
                </section>
            }
            @if (room.CanChat || room.Chat.Length > 0)
            {
                <section class="sg-panel" aria-labelledby="sg-chat-title">
                    <h2 id="sg-chat-title"><UiIcon Name="message" /> @Lang.T("Fælles chat", "Village chat")</h2>
                    @if (room.CanChat)
                    {
                        <form class="sg-chat-compose" @onsubmit="SendChatAsync" @onsubmit:preventDefault>
                            <label for="sg-chat-text">@Lang.T("Din besked", "Your message")</label>
                            <div class="sg-inline">
                                <input id="sg-chat-text" autocomplete="off" @bind="_chat" @bind:event="oninput" maxlength="500" />
                                <button type="submit" class="sg-button" disabled="@(_busy || string.IsNullOrWhiteSpace(_chat))">@Lang.T("Send", "Send")</button>
                            </div>
                        </form>
                    }
                    else { <p class="sg-hint">@Lang.T("Du kan læse de fælles beskeder her.", "You can read the village chat here.")</p> }
                    @if (room.Chat.Length == 0) { <p class="sg-hint">@Lang.T("Ingen beskeder endnu.", "No messages yet.")</p> }
                    else
                    {
                        <ol class="sg-messages" aria-label="@Lang.T("Beskeder, nyeste først", "Messages, newest first")">
                            @foreach (var line in room.Chat.Reverse())
                            {
                                <li @key="line.Id"><div><strong>@line.Sender</strong> <time datetime="@line.SentAt.ToString("O")">@line.SentAt.ToLocalTime().ToString("HH:mm")</time></div><p>@line.Text</p></li>
                            }
                        </ol>
                    }
                </section>
            }
        </div>
        <aside class="sg-stack sg-side">
            <section class="sg-panel">
                <h2><UiIcon Name="people" /> @Lang.T("Deltagere", "Players") <span class="sg-count">@room.Players.Length</span></h2>
                <ul class="sg-roster">
                    @foreach (var player in room.Players)
                    {
                        <li @key="player.Id" class="@(room.Game is { } g && !g.Alive.Contains(player.Id) ? "sg-eliminated" : null)">
                            <span>@player.Name@if (player.Id == room.Me) { <strong>@(" " + Lang.T("(dig)", "(you)"))</strong> }</span>
                            <small>@PlayerStatus(room, player)</small>
                        </li>
                    }
                </ul>
            </section>
            @if (room.IsHost && room.Game is null)
            {
                <SocialInvites @key="room.Code" Code="@room.Code" />
            }
        </aside>
    </div>
}
