<div class="sg-deck-counts" aria-label="Kort i bunken">
    <div><img src="@SocialText.RoleImage("wolf")" alt="" width="56" height="70" /><span><strong>@Wolves</strong> Varulve</span></div>
    <div><img src="@SocialText.RoleImage("villager")" alt="" width="56" height="70" /><span><strong>@Villagers</strong> Landsbyboere</span></div>
    <div class="sg-special-count"><span><strong>@Room.Settings.SpecialRoles.Length</strong> Specialkort</span></div>
</div>
@if (Room.IsHost)
{
    <fieldset class="sg-fieldset" disabled="@Busy">
        <legend>Antal varulve</legend>
        <div class="sg-choice-list">
            <label><input type="checkbox" checked="@(Room.Settings.Wolves is null)" @onchange="ToggleSuggested" /> Brug LUPs forslag (@Room.SuggestedWolves)</label>
            @if (Room.Settings.Wolves.HasValue)
            {
                <label>Dit antal <input type="number" class="sg-short" value="@Wolves" min="1" max="39" @onchange="SetWolves" /></label>
            }
        </div>
    </fieldset>
    <WerewolfRolePicker Editable="true" Selected="Room.Settings.SpecialRoles" Busy="@Busy" SelectionChanged="ChangeRolesAsync" />
    <fieldset class="sg-fieldset" disabled="@Busy">
        <legend>Tid til nattens valg</legend>
        <div class="sg-choice-list">
            <label><input type="radio" name="lobby-tempo" checked="@Room.Settings.Timed" @onchange="@(() => Change.InvokeAsync(Room.Settings with { Timed = true }))" /> 60 sekunder</label>
            <label><input type="radio" name="lobby-tempo" checked="@(!Room.Settings.Timed)" @onchange="@(() => Change.InvokeAsync(Room.Settings with { Timed = false }))" /> Fri tid</label>
        </div>
    </fieldset>
}
else
{
    <WerewolfRolePicker Selected="Room.Settings.SpecialRoles" />
    <dl class="sg-settings-summary">
        <dt>Nattens valg</dt><dd>@(Room.Settings.Timed ? "60 sekunder" : "Fri tid")</dd>
    </dl>
}
@if (Room.Settings.SpecialRoles.Contains("thief"))
{
    <p class="sg-hint">Med tyven blandes to ekstra landsbyboerkort i bunken. To tilfældige kort bliver liggende til tyvens valg.</p>
}

@code {
    [Parameter, EditorRequired] public SocialRoomView Room { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<SocialGameSettings> Change { get; set; }

    private int Wolves => Room.Settings.Wolves ?? Room.SuggestedWolves;
    private int Villagers => Math.Max(0, Room.Players.Length - Wolves - Room.Settings.SpecialRoles.Length)
        + (Room.Settings.SpecialRoles.Contains("thief") ? 2 : 0);

    private Task ToggleSuggested(ChangeEventArgs change) =>
        Change.InvokeAsync(Room.Settings with { Wolves = change.Value is true ? null : Room.SuggestedWolves });
    private Task SetWolves(ChangeEventArgs change) => int.TryParse(change.Value?.ToString(), out var value) && value > 0
        ? Change.InvokeAsync(Room.Settings with { Wolves = value }) : Task.CompletedTask;

    private Task ChangeRolesAsync(string[] roles) =>
        Change.InvokeAsync(Room.Settings with { SpecialRoles = roles });
}
