@page "/games/social/werewolf"
@inject AuthService Auth
@inject NavigationManager Nav
@inject SocialGamesClient Client

<PageTitle>Opret Werewolf-lobby · LUP</PageTitle>
<SocialFrame>
    <header class="sg-creation-header">
        <img src="/images/social-games/werewolf.webp" alt="" width="1200" height="800" />
        <div>
            <h1>Werewolf</h1>
            <p>Vælg jeres rollekort, og invitér landsbyen. LUP er spilleder.</p>
        </div>
    </header>
    <div class="sg-create-grid @(Auth.IsAuthenticated ? null : "sg-create-guest")">
        <div class="sg-create-cards">
            <WerewolfRolePicker Editable="@Auth.IsAuthenticated" Selected="_roles" ShowAll="true"
                                SelectionChanged="SelectRoles" Busy="@_busy" />
        </div>
        <section class="sg-panel sg-create-controls" aria-label="Lobbyindstillinger">
            <div class="sg-base-roles">
                <h2>Grundroller</h2>
                <div>
                    <span><img src="@SocialText.RoleImage("wolf")" width="48" height="60" alt="" />Varulv</span>
                    <span><img src="@SocialText.RoleImage("villager")" width="48" height="60" alt="" />Landsbyboer</span>
                </div>
            </div>
            @if (Auth.IsAuthenticated)
            {
                <fieldset class="sg-fieldset" disabled="@_busy">
                    <legend>Tid til nattens valg</legend>
                    <div class="sg-choice-list">
                        <label><input type="radio" name="tempo" checked="@_timed" @onchange="@(() => _timed = true)" /> 60 sekunder pr. valg</label>
                        <label><input type="radio" name="tempo" checked="@(!_timed)" @onchange="@(() => _timed = false)" /> Fri tid</label>
                    </div>
                </fieldset>
                <button class="sg-button primary" @onclick="CreateAsync" disabled="@_busy"><UiIcon Name="plus" /> @(_busy ? "Opretter…" : "Opret lobby")</button>
            }
            else
            {
                <a class="sg-button primary" href="@Auth.LoginPath()">Log ind og opret lobby</a>
                <a class="sg-plain" href="/games/social">Deltag med en kode</a>
            }
            @if (_error is not null)
            {
                <p class="sg-error" role="alert">@_error</p>
            }
        </section>
    </div>
</SocialFrame>

@code {
    private bool _timed = true, _busy;
    private string[] _roles = ["seer"];
    private string? _error;
    private void SelectRoles(string[] roles) => _roles = roles;

    private async Task CreateAsync()
    {
        if (_busy) return;
        _busy = true;
        _error = null;
        try
        {
            var room = await Client.CreateAsync(new(_roles, null, _timed));
            Nav.NavigateTo($"/games/social/{Uri.EscapeDataString(room.Code)}");
        }
        catch (Exception ex) when (SocialText.IsRequestError(ex)) { _error = SocialText.Error(ex); }
        finally { _busy = false; }
    }
}
