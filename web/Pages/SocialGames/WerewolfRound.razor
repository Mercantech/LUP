<section class="sg-phase @(Game.Phase == "night" ? "sg-night" : null)" aria-label="@Lang.T("Spillets fase", "Game phase")">
    <div class="sg-phase-name">
        <h2>@Lang.Phase(Game.Phase)</h2>
        @if (Game.Round > 0 && !Game.Finished) { <span>@Lang.T("Runde", "Round") @Game.Round</span> }
    </div>
    @if (!string.IsNullOrWhiteSpace(Game.PublicMessage)) { <p aria-live="polite">@PublicMessage</p> }
    @if (Game.Finished && !string.IsNullOrEmpty(Game.Result) && Game.Result != Game.PublicMessage) { <p class="sg-outcome">@Result</p> }
</section>

<section class="sg-panel sg-private">
    <div class="sg-section-heading">
        <h2><UiIcon Name="lock" /> @Lang.T("Mit rollekort", "My role card")</h2>
        <button type="button" class="sg-button sg-card-toggle" @onclick="TogglePrivate"
                aria-expanded="@(_privateOpen ? "true" : "false")" aria-controls="sg-private-info">
            <span class="sg-card-back" aria-hidden="true"></span>
            @(_privateOpen ? Lang.T("Skjul kort", "Hide card") : Lang.T("Vis mit kort", "Show my card"))
        </button>
    </div>
    @if (_privateOpen)
    {
        <div id="sg-private-info" class="sg-secret">
            <div class="sg-role-card sg-revealed-role">
                <WerewolfRoleFace Role="@Game.Role" Revealed="true" />
            </div>
            @if (Game.PrivateMessages.Length > 0 || Game.Phase == "night")
            {
                <div class="sg-private-details">
                    @if (Game.PrivateMessages.Length > 0)
                    {
                        <ul>@foreach (var message in PrivateMessages) { <li>@message</li> }</ul>
                    }
                    @if (Game.Phase == "night")
                    {
                        <WerewolfChoices Game="Game" Busy="Busy" Submit="Submit" />
                        @if (Game.Actions.Length == 0 && !Game.Finished) { <p>@Lang.T("Vent på, at natten går videre.", "Wait for the next part of the night.")</p> }
                    }
                </div>
            }
        </div>
    }
    else if (Game.Phase == "night")
    {
        <p class="sg-hint">@Lang.T("Åbn dit kort for at se dine hemmelige beskeder og valg.", "Open your card to see your private messages and choices.")</p>
    }
</section>
@if (Game.Phase != "night" && Game.Actions.Length > 0)
{
    <section class="sg-panel"><WerewolfChoices Game="Game" Busy="Busy" Submit="Submit" /></section>
}
@if (Game.Finished)
{
    <a class="sg-button" href="/games/social">@Lang.T("Til spilhubben", "Back to the game hub")</a>
}

@code {
    [CascadingParameter] public SocialGameLanguage Lang { get; set; } = new();
    [Parameter, EditorRequired] public SocialRoomView Room { get; set; } = default!;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<SocialGameActionRequest> Submit { get; set; }
    private WerewolfView Game => Room.Game!;
    private string PublicMessage => Lang.IsEnglish
        ? Game.English?.PublicMessage ?? Lang.Server(Game.PublicMessage) : Game.PublicMessage;
    private IEnumerable<string> PrivateMessages => Lang.IsEnglish
        ? Game.English?.PrivateMessages ?? Game.PrivateMessages.Select(Lang.Server) : Game.PrivateMessages;
    private string? Result => Game.Result is { } result && Lang.IsEnglish
        ? Game.English?.Result ?? Lang.Server(result) : Game.Result;
    private bool _privateOpen;
    private void TogglePrivate() => _privateOpen = !_privateOpen;
}
