<span class="sg-role-portrait">
    <img class="sg-role-image" src="@SocialText.RoleImage(Role)" alt="" width="320" height="400" loading="lazy" decoding="async" />
</span>
<span class="sg-role-caption">
    <strong>@SocialRoles.Names[Role]</strong>
    <small id="@DescriptionId">@SocialText.RoleRule(Role)</small>
</span>

@code {
    [Parameter, EditorRequired] public string Role { get; set; } = "";
    [Parameter] public string? DescriptionId { get; set; }
}
