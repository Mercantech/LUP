@if (SocialRoles.Names.ContainsKey(Role))
{
    <span class="sg-role-portrait">
        <img class="sg-role-image" src="@SocialText.RoleImage(Role)" alt="" width="480" height="600"
             loading="@(Revealed ? "eager" : "lazy")" decoding="async" />
    </span>
}
@if (Revealed)
{
    <div class="sg-role-caption">
        <h3>@Lang.Role(Role)</h3>
        <p>@Lang.Rule(Role)</p>
    </div>
}
else
{
    <span class="sg-role-caption">
        <span class="sg-role-title">
            <strong>@Lang.Role(Role)</strong>
            @if (Selected is bool selected)
            {
                <span class="sg-role-mark" aria-hidden="true"><UiIcon Name="@(selected ? "check" : "plus")" /></span>
            }
        </span>
        <small id="@DescriptionId">@Lang.Rule(Role)</small>
    </span>
}

@code {
    [CascadingParameter] public SocialGameLanguage Lang { get; set; } = new();
    [Parameter, EditorRequired] public string Role { get; set; } = "";
    [Parameter] public string? DescriptionId { get; set; }
    [Parameter] public bool? Selected { get; set; }
    [Parameter] public bool Revealed { get; set; }
}
