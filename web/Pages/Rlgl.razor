@page "/rlgl"
@page "/rlgl/admin"
@implements IAsyncDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject AuthService Auth

<PageTitle>Red Light, Green Light | LUP</PageTitle>
<section class="rlgl">
    <h1>Red Light, Green Light</h1>
    <p>Arduino Oplà · Live løbebane · Signalstyrke, ikke meter</p>
    @if (Auth.IsAuthenticated && Auth.Roles.Any(r => new[] { "Admin", "Underviser", "Teacher", "Instructor" }.Contains(r, StringComparer.OrdinalIgnoreCase)))
    {
        <button @onclick="Create" disabled="@(_busy || _admission is not null)">Opret spilrum</button>
    }
    @if (_admission is not null)
    {
        <details><summary>Arduino-opsætning (hold nøglen privat)</summary>
            <p>Send denne linje til hver Arduino i Serial Monitor:</p>
            <code>ROOM @_admission.Code @_admission.DeviceKey</code>
            <p>Rum: @_admission.Code</p>
            <p>Tilskuernøgle: <code>@_admission.ViewKey</code></p>
        </details>
        <div class="controls">
            <button @onclick='() => Control("green")'>Grønt lys</button>
            <button @onclick='() => Control("red")'>Rødt lys</button>
            <button @onclick='() => Control("idle")'>Stop</button>
            <button @onclick='() => Control("idle", true)'>Nulstil løb</button>
        </div>
        <div class="controls">
            <label>Målgrænse <input type="number" min="15" max="90" @bind="_threshold" /></label>
            <label>EMA <input type="number" min="0.05" max="1" step="0.05" @bind="_alpha" /></label>
            <label>Scan (ms) <input type="number" min="500" max="2000" step="50" @bind="_interval" /></label>
            <button @onclick="Apply">Gem indstillinger</button>
        </div>
    }
    else
    {
        <div class="controls">
            <label>Rumkode <input @bind="_code" maxlength="12" /></label>
            <label>Tilskuernøgle <input type="password" @bind="_viewKey" maxlength="48" /></label>
            <button @onclick="Connect">Se løbet</button>
        </div>
    }
    <p role="status">@_status</p>
    @if (_snapshot is { } s)
    {
        <div class="light @s.Light">@(s.Light == "green" ? "GRØNT LYS" : s.Light == "red" ? "RØDT LYS" : "AFVENTER")</div>
        <p>Runde @s.Round · @s.Players.Count(p => p.Online) online · @s.Players.Count(p => p.Place.HasValue) i mål</p>
        <div class="scale"><span>100 · START</span><span>@s.Settings.Threshold · MÅL</span></div>
        @foreach (var player in s.Players)
        {
            <div class="lane" @key="player.Number">
                <div><strong>Spiller @player.Number</strong> <span>@PlayerStatus(player)</span></div>
                <div class="track" aria-label="@PlayerStatus(player)">
                    <div class="progress" style="@ProgressStyle(player,s.Settings.Threshold)"></div>
                </div>
                <small>RSSI: @(player.Rssi?.ToString("F1") ?? "—") dBm · Rå: @(player.RawRssi?.ToString("F1") ?? "—")</small>
            </div>
        }
        @if (s.Players.Length == 0) { <p>Ingen spillere endnu. Tilslut en Arduino med rummets enhedsnøgle.</p> }
    }
</section>

@code {
    private record Admission(string Code, string DeviceKey, string ViewKey);
    private record Settings(double Threshold, double Alpha, int IntervalMs);
    private record Player(int Number, double? Rssi, double? RawRssi, bool Fresh, bool Online, int? Place);
    private record Snapshot(string Code, string Light, int Round, Settings Settings, Player[] Players);
    private Admission? _admission;
    private Snapshot? _snapshot;
    private IJSObjectReference? _module;
    private DotNetObjectReference<Rlgl>? _reference;
    private string _code = "", _viewKey = "", _status = "Opret eller tilslut et spilrum.";
    private double _threshold = 30, _alpha = 0.2;
    private int _interval = 750;
    private bool _busy, _disposed;
    private async Task Create()
    {
        _busy = true;
        try
        {
            using var response = await Http.PostAsJsonAsync("rlgl/rooms", new { });
            if (!response.IsSuccessStatusCode) { _status = "Kunne ikke oprette rum: " + (int)response.StatusCode; return; }
            _admission = await response.Content.ReadFromJsonAsync<Admission>();
            if (_admission is null) return;
            _code = _admission.Code;
            _viewKey = _admission.ViewKey;
            await Connect();
        }
        catch (Exception) { _status = "Kunne ikke oprette rum."; }
        finally { _busy = false; }
    }
    private async Task Connect()
    {
        if (_disposed) return;
        try
        {
            _snapshot = null;
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/rlgl-live.js");
            _reference ??= DotNetObjectReference.Create(this);
            var endpoint = new Uri(Http.BaseAddress!, "rlgl/live").ToString();
            await _module.InvokeVoidAsync("connect", _reference, endpoint, _code.Trim(), _viewKey.Trim());
        }
        catch (Exception) { _status = "Forbindelsen kunne ikke startes."; }
    }
    private Task Apply() => Control(_snapshot?.Light ?? "idle", settings: new(_threshold,_alpha,_interval));
    private async Task Control(string light, bool reset = false, Settings? settings = null)
    {
        if (_admission is null) return;
        try
        {
            using var response = await Http.PostAsJsonAsync("rlgl/rooms/" + _admission.Code + "/control", new { light, reset, settings });
            if (!response.IsSuccessStatusCode) _status = "Ændringen blev afvist: " + (int)response.StatusCode;
        }
        catch (Exception) { _status = "Kontrolforbindelsen fejlede."; }
    }
    [JSInvokable] public Task ReceiveSnapshot(string json)
    {
        if (_disposed) return Task.CompletedTask;
        return InvokeAsync(() =>
        {
            _snapshot = System.Text.Json.JsonSerializer.Deserialize<Snapshot>(json, System.Text.Json.JsonSerializerOptions.Web);
            _status = "Live";
            StateHasChanged();
        });
    }
    [JSInvokable] public Task ConnectionStatus(string status) => InvokeAsync(() => { if (!_disposed) { _status = status; _snapshot = null; StateHasChanged(); } });
    private static string PlayerStatus(Player p) => p.Place is int place ? place + ". plads" : !p.Online ? "Offline" : !p.Fresh ? "Ingen frisk måling" : "På vej";
    private static string ProgressStyle(Player p, double threshold)
    {
        var value = p.Place.HasValue ? 100 : p.Online && p.Rssi is double rssi ? Math.Clamp((100 + rssi) / (100 - threshold) * 100,0,100) : 0;
        return "width:" + value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null) { try { await _module.InvokeVoidAsync("disconnect"); await _module.DisposeAsync(); } catch (JSException) {} }
        _reference?.Dispose();
    }
}
