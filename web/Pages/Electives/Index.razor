@page "/valgfag"
@page "/electives"
@using Mercantec.Tech.Web.Electives
@inject ElectiveClient Client
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject ViewAsStudentContext ViewAs
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>@(SelectedPackage?.Title ?? "Valgfag") · LUP</PageTitle>

<div class="electives-page">
    @if (IsPackageIndex)
    {
        <header class="electives-cover" data-scheme="orbit">
            <img class="electives-orbit" src="/images/valgfag/valgfag-overblik.webp" alt="" width="1000" height="1000" fetchpriority="high" />
            <div class="electives-intro">
                <h1>Valgfag</h1>
                <p>Udforsk de tre fagpakker, og se, hvornår næste hold starter.</p>
                <a class="electives-cover-link" href="/valgfag?vis=aktuelle"><UiIcon Name="calendar" /> Se aktuelle hold</a>
            </div>
        </header>
    }

    <nav class="electives-nav" aria-label="Valgfagsoversigt">
        <a href="/valgfag" aria-current="@CurrentLink("katalog")">Fagpakker</a>
        <a href="/valgfag?vis=aktuelle" aria-current="@CurrentLink("aktuelle")">Aktuelle hold</a>
        @if (!Redirect.ShowsTeacherChrome && !ViewAs.IsActive)
        {
            <a href="/valgfag?vis=mine" aria-current="@CurrentLink("mine")">Mine tilmeldinger</a>
        }
        <a href="/valgfag?vis=historik" aria-current="@CurrentLink("historik")">Tidligere hold</a>
        @if (_canManage)
        {
            <a href="/valgfag?vis=administrer" aria-current="@CurrentLink("administrer")">Administrér</a>
        }
    </nav>

    @if (_notice is not null)
    {
        <p class="electives-notice" role="status">@_notice</p>
    }

    @if (_loading)
    {
        <p class="electives-feedback" role="status">Henter valgfag…</p>
    }
    else if (_error is not null)
    {
        <div class="electives-feedback" role="alert">
            <p>@_error</p>
            <button class="secondary" type="button" @onclick="Load">Prøv igen</button>
        </div>
    }
    else if (IsPackageIndex)
    {
        <section aria-labelledby="packages-title">
            <h2 class="electives-section-title" id="packages-title">Vælg din fagpakke</h2>
            <div class="electives-packages">
                @foreach (var package in AvailablePackages)
                {
                    var next = UpcomingFor(package.Id).FirstOrDefault();
                    <a class="package" href="@package.Href" aria-labelledby="@($"package-{package.Id:N}")">
                        <img class="package-cover" src="@package.ImageUrl" alt="" width="600" height="400" />
                        <div class="package-copy">
                            <h3 id="@($"package-{package.Id:N}")">@package.Title</h3>
                            <p>@package.Summary</p>
                            <div class="package-details">
                                @if (package.Character is { DisplayPortrait: { } portrait } character)
                                {
                                    <div class="package-character">
                                        <img src="@portrait.Image" alt="" width="36" height="36" loading="lazy" />
                                        <span>Med @character.Name</span>
                                    </div>
                                }
                                <div class="package-meta">
                                    <UiIcon Name="calendar" />
                                    <span>@ElectiveDisplay.StartLabel(next)</span>
                                </div>
                            </div>
                            <span class="package-action">Se fagpakke <UiIcon Name="arrow" /></span>
                        </div>
                    </a>
                }
            </div>
            @if (!AvailablePackages.Any())
            {
                <p class="electives-feedback">Der er endnu ingen fagpakker i kataloget.</p>
            }
        </section>
        <ElectiveGuide />
    }
    else if (SelectedPackage is { } packageDetail && FindTemplate(packageDetail.Id) is { } template)
    {
        <ElectivePackageDetail Package="packageDetail" Template="template" Offerings="UpcomingFor(packageDetail.Id)"
                               CanManage="_canManage" OnEnrollmentChanged="EnrollmentChanged" OnRefresh="Load" />
    }
    else if (ActiveView == "administrer")
    {
        <ElectiveManagement Items="_items" InitialTemplate="SelectedTemplate" SearchItem="SearchItem" InitialRosterId="@(RosterRequested == true ? SearchItem : null)" OnRosterChanged="Replace" OnSaved="ElectiveSaved" OnRefresh="Load" />
    }
    else
    {
        <section class="electives-list-section" aria-labelledby="electives-list-title">
            <div class="electives-list-header">
                <div>
                    <h1 id="electives-list-title">@ViewTitle</h1>
                    <p>@ViewDescription</p>
                </div>
                @if (VisibleItems.Any() && SearchItem is null)
                {
                    <label class="field electives-search">
                        Find valgfag
                        <input type="search" placeholder="Søg efter titel eller indhold" @bind="_search" @bind:event="oninput" />
                    </label>
                }
            </div>

            @if (!VisibleItems.Any())
            {
                <p class="electives-feedback">@EmptyText</p>
            }
            else if (!MatchingItems.Any())
            {
                <p class="electives-feedback">@(SearchItem is null ? "Ingen valgfag matcher din søgning." : "Valgfaget blev ikke fundet.")</p>
            }
            else
            {
                @foreach (var group in MatchingItems.GroupBy(ArchiveYear))
                {
                    @if (ActiveView == "historik")
                    {
                        <h2 class="electives-archive-year">@(group.Key?.ToString() ?? "Uden dato")</h2>
                    }
                    <div class="electives-grid">
                        @foreach (var item in group)
                        {
                            <ElectiveCard @key="item.Id" Item="item" Template="FindTemplate(item.TemplateId)" CanManage="_canManage"
                                          OnEnrollmentChanged="EnrollmentChanged" OnRefresh="Load" />
                        }
                    </div>
                }
            }
        </section>
        @if (ActiveView == "historik")
        {
            <ElectiveArchiveDocuments />
        }
        @if (ActiveView == "aktuelle")
        {
            <ElectiveGuide />
        }
    }
</div>
