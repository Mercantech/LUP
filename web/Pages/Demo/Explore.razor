@page "/explore/projects"
@page "/badges"
@page "/help"
@page "/sources"
@using Mercantec.Tech.Web.Demo
@inject NavigationManager Nav
@inject AuthService Auth
@inject AuthRedirect Redirect
@inject ViewAsStudentContext ViewAs
@implements IDisposable

<PageTitle>@Title</PageTitle>

@if (!Auth.IsInitialized)
{
    <p>Indlæser…</p>
}
else if (!Auth.IsAuthenticated && PathKey == "explore/modules")
{
    <p>Du skal være logget ind. <a href="@Auth.LoginPath()">Log ind</a></p>
}
else if (PathKey == "explore/projects")
{
    <nav class="breadcrumbs" aria-label="Brødkrummer"><a href="/library?category=projects">Oversigt</a><span>›</span><span aria-current="page">Offentlige projekter</span></nav>
    <header class="page-title"><div><h1>Offentlige projekter</h1><p>Projekteksemplerne er markeret DEMO.</p></div>@if (Auth.IsAuthenticated) { <a class="secondary" href="/projects/mine">Mine projekter</a> }</header><PublicProjectGallery />
    @if (Auth.IsAuthenticated) { <div class="headrow"><h2>Delt i holdets galleri</h2></div><ProjectGallery /> }
}
else if (PathKey == "explore/modules")
{
    <header class="page-title"><div><h1>Fag og emner</h1><p>Gå på opdagelse, eller find det næste emne i dit forløb.</p></div></header>@foreach (var course in DemoCatalog.Courses) { <div class="headrow"><h2>@course.Name</h2><a href="/learning/@course.Id">Åbn forløbet</a></div><SubjectCards Course="course" /> }
}
else if (PathKey == "badges")
{
    <PublicBadgeCatalog ShowCollectionLink="Auth.IsAuthenticated" />
}
else if (PathKey == "help")
{
    <header class="page-title"><div><h1>Hjælp</h1><p>Find det, du skal bruge i LUP.</p></div></header>
    <article class="article">
        @if (Auth.IsAuthenticated)
        {
            <h2>Find dine hold og opgaver</h2>
            <p>Vælg LUP-logoet for at komme til dit <a href="@(Redirect.ShowsTeacherChrome ? "/teacher" : "/student")">overblik</a>. Under <a href="/courses">Mine hold</a> kan du åbne et hold og vælge <strong>Undervisning</strong>, <strong>Opgaver</strong> eller <strong>Kalender</strong>.</p>

            <h2>Se din kalender</h2>
            @if (Redirect.ShowsTeacherChrome)
            {
                <p>Åbn avatarmenuen og vælg <a href="/teacher/planner">Min kalender</a> under <strong>Undervisning</strong>. Her kan du se og ændre holdenes plan sammen med dine egne Outlook-aftaler.</p>
                <h2>Underviserens værktøjer</h2>
                <p>I samme menu ligger <a href="/teacher/tools">Underviserværktøjer</a> med genveje til holdenes værktøjer. Brug <a href="/notifications">Til opfølgning</a> til at finde afleveringer, der venter på feedback.</p>
            }
            else
            {
                <p>Åbn avatarmenuen og vælg <a href="/student/calendar">Min kalender</a> under <strong>Genveje</strong>. Her ser du dagens plan og kommende frister for dine hold.</p>
            }

            <h2>Find noter og materialer</h2>
            <p>Vælg <a href="/notion">Notesbøger</a> for at finde noter og logbøger. Brug <a href="/search">Søg</a> til at finde indhold, eller se undervisningsplaner, fag og projekter under <a href="/library">Oversigt</a>.</p>
            @if (!ViewAs.IsActive)
            {
                <h2>Din konto</h2>
                <p>Under avatarmenuens <a href="/profile">Min profil</a> finder du dine indstillinger. LUP-klokken viser dine notifikationer.</p>
            }
        }
        else
        {
            <h2>Udforsk LUP</h2>
            <p>Under <a href="/library">Oversigt</a> finder du offentlige undervisningsplaner, fag og projekter. <a href="@Auth.LoginPath()">Log ind</a> for at se dine hold, opgaver og din kalender.</p>
        }
    </article>
}
else
{
    <AboutLup />
}

@code {
    private string PathKey
    {
        get
        {
            var relative = Nav.ToBaseRelativePath(Nav.Uri);
            var cut = relative.IndexOfAny(['?', '#']);
            if (cut >= 0)
                relative = relative[..cut];
            return relative.Trim('/');
        }
    }

    private string Title => PathKey switch
    {
        "explore/projects" => "Galleri",
        "explore/modules" => "Fag og emner",
        "badges" => "Badges",
        "help" => "Hjælp",
        _ => "Om LUP"
    };

    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += OnAuth;
        ViewAs.Changed += OnAuth;
        Nav.LocationChanged += OnLocation;
    }
    private void OnAuth() => InvokeAsync(StateHasChanged);
    private void OnLocation(object? sender, LocationChangedEventArgs e) => InvokeAsync(StateHasChanged);
    public void Dispose()
    {
        Auth.AuthStateChanged -= OnAuth;
        ViewAs.Changed -= OnAuth;
        Nav.LocationChanged -= OnLocation;
    }
}
