@page "/videnstjek/{DistributionId:guid}"
@using Mercantec.Tech.Web.Notion
@inject AuthService Auth
@inject ViewAsStudentContext ViewAs
@inject IJSRuntime JS
@inject HttpClient Http
@implements IAsyncDisposable

<PageTitle>Videnstjek · LUP</PageTitle>
<header class="page-title">
    <div>
        <nav class="breadcrumbs" aria-label="Brødkrummer"><a href="/videnstjek">Alle videnstjek</a></nav>
        <h1>Videnstjek</h1>
    </div>
</header>
@if (ViewAs.IsActive)
{
    <p>Åbn Videnstjek fra elevens egen konto for at besvare spørgsmål eller se forsøg.</p>
}
else if (!Auth.IsAuthenticated)
{
    <p><a href="@Auth.LoginPath()">Log ind</a> for at åbne videnstjekket.</p>
}
else if (_failedScope is not null && _failedScope == Scope)
{
    <p role="alert">Videnstjek kunne ikke indlæses.</p>
    <button class="secondary" type="button" @onclick="Retry">Prøv igen</button>
}
else if (_mountedScope != Scope)
{
    <p role="status">Henter videnstjek…</p>
}
<div @ref="_host" hidden="@(Scope is null || _mountedScope != Scope || _failedScope == Scope)"></div>

@code {
    [Parameter] public Guid DistributionId { get; set; }
    [SupplyParameterFromQuery(Name = "forsog")] public Guid? AttemptId { get; set; }

    private DotNetObjectReference<Runner>? _callback;
    private IJSObjectReference? _module;
    private ElementReference _host;
    private MountScope? _mountedScope, _failedScope;
    private bool _mounting, _disposed;

    private MountScope? Scope => Auth.IsAuthenticated && Auth.Subject is { } account && !ViewAs.IsActive
        ? new(DistributionId, AttemptId, account, Http.BaseAddress?.AbsoluteUri ?? "/api/")
        : null;

    protected override void OnInitialized()
    {
        Auth.AuthStateChanged += AccountChanged;
        ViewAs.Changed += AccountChanged;
    }

    private void AccountChanged() => _ = InvokeAsync(StateHasChanged);

    protected override void OnParametersSet()
    {
        if (_failedScope != Scope) _failedScope = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        var scope = Scope;
        if (_disposed || _mounting || scope == _mountedScope || (scope is not null && scope == _failedScope)) return;

        _mounting = true;
        try
        {
            if (scope is null)
            {
                if (_module is not null) await _module.InvokeVoidAsync("unmount", _host);
            }
            else
            {
                var module = _module ?? await JS.InvokeAsync<IJSObjectReference>("import", EditorAssets.KnowledgeCheckScript);
                if (_disposed)
                {
                    await module.DisposeAsync();
                    return;
                }
                _module = module;
                if (scope != Scope) return;
                _callback ??= DotNetObjectReference.Create(this);
                await module.InvokeVoidAsync("mount", _host, scope, _callback);
            }
            _mountedScope = scope;
            _failedScope = null;
        }
        catch (JSException)
        {
            if (scope is null) _mountedScope = null;
            else if (!_disposed && scope == Scope) _failedScope = scope;
        }
        finally
        {
            _mounting = false;
            if (!_disposed) StateHasChanged();
        }
    }

    private void Retry() => _failedScope = null;

    [JSInvokable]
    public async Task<string?> GetKnowledgeCheckToken(string account, string? rejectedAccess)
    {
        if (_disposed || ViewAs.IsActive || !Auth.IsAuthenticated || Auth.Subject != account)
            return null;

        var access = await (rejectedAccess is null
            ? Auth.GetValidAccessTokenAsync()
            : Auth.RefreshAfterUnauthorizedAsync(rejectedAccess));
        return !_disposed && !ViewAs.IsActive && Auth.Subject == account ? access : null;
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Auth.AuthStateChanged -= AccountChanged;
        ViewAs.Changed -= AccountChanged;
        try
        {
            if (_module is null) return;
            try { await _module.InvokeVoidAsync("unmount", _host); }
            finally { await _module.DisposeAsync(); }
        }
        catch (JSException) { }
        finally { _callback?.Dispose(); }
    }

    private sealed record MountScope(Guid DistributionId, Guid? AttemptId, string Account, string ApiBase);
}
