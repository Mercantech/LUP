@page "/videnstjek"
@implements IDisposable

<PageTitle>Videnstjek · LUP</PageTitle>

<div class="knowledge-catalog">
    <header class="page-title knowledge-title">
        <div>
            <h1>Videnstjek</h1>
            <p>Prøv det, du har lært, og se, hvad du vil øve dig på igen.</p>
        </div>
        @if (CanManage && View == "administrer")
        {
            <a class="action" href="/videnstjek/rediger/ny"><UiIcon Name="plus" /> Opret videnstjek</a>
        }
    </header>

    @if (ViewAs.IsActive)
    {
        <p class="panel">Afslut elevvisningen for at åbne Videnstjek med din egen konto.</p>
    }
    else if (_error is not null)
    {
        <div class="panel">
            <p role="alert">@_error</p>
            <button type="button" class="secondary" @onclick="LoadAsync">Prøv igen</button>
        </div>
    }
    else if (_index is null)
    {
        <div class="knowledge-section" aria-busy="true">
            <p role="status">Henter videnstjek…</p>
            <div class="knowledge-grid" aria-hidden="true">
                <div class="knowledge-placeholder"></div>
                <div class="knowledge-placeholder"></div>
            </div>
        </div>
    }
    else
    {
        <nav class="knowledge-nav" aria-label="Videnstjek">
            @foreach (var tab in Tabs)
            {
                @if (tab.Key != "administrer" || CanManage)
                {
                    <a href="@ViewUrl(tab.Key)" aria-current="@(View == tab.Key ? "page" : null)">
                        @tab.Label
                        @if (tab.Key == "tildelinger" && AssignmentCount > 0)
                        {
                            <span class="knowledge-nav-count" aria-label="@($"{AssignmentCount} aktive")">@AssignmentCount</span>
                        }
                    </a>
                }
            }
        </nav>

        @if (View == "administrer")
        {
            <section class="knowledge-section" aria-labelledby="knowledge-drafts">
                <div class="knowledge-section-heading">
                    <h2 id="knowledge-drafts">Kladder</h2>
                    <button type="button" class="secondary" @onclick="CreatePilotAsync" disabled="@_creatingPilot">Opret fra GF2-eksempel</button>
                </div>
                @if (_pilotError is not null)
                {
                    <p role="alert">@_pilotError</p>
                }
                <details class="panel knowledge-import">
                    <summary>Importér fra det gamle Videnstjek</summary>
                    <p>Kopiér hele det gamle quizkatalog til dine egne kladder med forklaringer og kildelinks.</p>
                    <div class="actions">
                        <button type="button" class="secondary" @onclick="ImportLegacyAsync" disabled="@_importingLegacy">
                            @(_importingLegacy ? "Importerer…" : "Importér som kladder")
                        </button>
                    </div>
                    @if (_importError is not null)
                    {
                        <p role="alert">@_importError</p>
                    }
                    @if (_importStatus is not null)
                    {
                        <p role="status">@_importStatus</p>
                    }
                </details>
                @if (!_index.Owned.Any())
                {
                    <p class="panel">Opret et videnstjek, eller prøv med et færdigt GF2-eksempel.</p>
                }
                else
                {
                    <div class="knowledge-list">
                        @foreach (var draft in _index.Owned)
                        {
                            <article class="panel knowledge-row" @key="draft.Id">
                                <div>
                                    <h3>@draft.Title</h3>
                                    <p class="knowledge-row-meta"><span>@draft.Topic</span><span>@QuestionLabel(draft.QuestionCount)</span></p>
                                </div>
                                <a class="secondary" href="/videnstjek/rediger/@draft.Id">Rediger<span class="visually-hidden"> @draft.Title</span></a>
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="knowledge-section" aria-labelledby="knowledge-publications">
                <h2 id="knowledge-publications">Udgivelser</h2>
                @if (!Managed.Any())
                {
                    <p class="panel">Udgivne videnstjek vises her.</p>
                }
                else
                {
                    <div class="knowledge-list">
                        @foreach (var publication in Managed)
                        {
                            <article class="panel knowledge-row" @key="publication.Id">
                                <div>
                                    <h3>@publication.Title</h3>
                                    <p class="knowledge-row-meta"><span>@(publication.HoldName ?? "Fri øvelse")</span><span>@(publication.IsActive ? "Aktiv" : "Lukket")</span></p>
                                </div>
                                <div class="actions">
                                    @if (publication.HoldId is not null)
                                    {
                                        <a class="secondary" href="/videnstjek/@publication.Id/resultater">Holdresultater<span class="visually-hidden"> for @publication.Title</span></a>
                                    }
                                    @if (publication.IsActive)
                                    {
                                        <a class="secondary" href="/videnstjek/@publication.Id">Åbn udgivelse<span class="visually-hidden"> @publication.Title</span></a>
                                    }
                                    @if (_index.Owned.Any(draft => draft.Id == publication.QuizId))
                                    {
                                        <a class="secondary" href="/videnstjek/rediger/@publication.QuizId#udgivelser">Administrér<span class="visually-hidden"> @publication.Title</span></a>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        }
        else if (View == "historik")
        {
            <section class="knowledge-section" aria-labelledby="knowledge-history">
                <h2 id="knowledge-history">Min historik</h2>
                @if (!_index.History.Any())
                {
                    <p class="panel">Dine forsøg vises her, når du er begyndt på dit første videnstjek.</p>
                }
                else
                {
                    <div class="knowledge-list">
                        @foreach (var attempt in _index.History)
                        {
                            <article class="panel knowledge-row" @key="attempt.AttemptId">
                                <div>
                                    <h3>@attempt.Title</h3>
                                    <p class="knowledge-row-meta">
                                        <span>@StatusLabel(attempt.Status)</span>
                                        <span>@FormatDate(attempt.SubmittedAtUtc ?? attempt.StartedAtUtc)</span>
                                        @if (attempt.Score is not null)
                                        {
                                            <span>@attempt.Score af @attempt.QuestionCount point</span>
                                        }
                                    </p>
                                </div>
                                @if (attempt.CanOpen)
                                {
                                    <a class="secondary" href="@($"/videnstjek/{attempt.PublicationId}?forsog={attempt.AttemptId}")">@(attempt.Status == "started" ? "Fortsæt" : "Se forsøg")<span class="visually-hidden"> for @attempt.Title</span></a>
                                }
                            </article>
                        }
                    </div>
                }
            </section>
        }
        else if (View == "tildelinger")
        {
            <section class="knowledge-section" aria-labelledby="knowledge-assignments">
                <h2 id="knowledge-assignments">Mine tildelinger</h2>
                @if (AssignmentCount == 0)
                {
                    <p class="panel">Du har ingen aktive videnstjek fra dine hold.</p>
                }
                else
                {
                    <div class="knowledge-grid">
                        @foreach (var publication in Assignments)
                        {
                            <article class="panel knowledge-card" @key="publication.Id">
                                <div class="knowledge-card-body">
                                    <h3>@publication.Title</h3>
                                    @if (!string.IsNullOrWhiteSpace(publication.Description))
                                    {
                                        <p class="knowledge-description">@publication.Description</p>
                                    }
                                    <p class="knowledge-row-meta">
                                        <span>@(publication.HoldName ?? publication.Topic)</span>
                                        <span>@QuestionLabel(publication.QuestionCount)</span>
                                        @if (publication.EstimatedMinutes is > 0)
                                        {
                                            <span>@publication.EstimatedMinutes min.</span>
                                        }
                                    </p>
                                </div>
                                <a class="secondary" href="/videnstjek/@publication.Id">@AssignmentAction(publication)<span class="visually-hidden"> @publication.Title</span></a>
                            </article>
                        }
                    </div>
                }
            </section>
        }
        else
        {
            var items = FilteredPractice.ToArray();
            <section class="knowledge-section knowledge-practice" aria-labelledby="knowledge-available">
                <div class="knowledge-discovery">
                    <h2 id="knowledge-available">Frie øvelser</h2>
                    <nav class="knowledge-topics" aria-label="Emne">
                        <a href="@TopicUrl("")" aria-current="@(Topic.Length == 0 ? "true" : null)">Alle</a>
                        @foreach (var topic in Topics)
                        {
                            <a href="@TopicUrl(topic)" aria-current="@(Danish.Equals(Topic, topic) ? "true" : null)">@topic</a>
                        }
                    </nav>
                    <div class="knowledge-filters">
                        <label class="field">
                            Søg i øvelser
                            <span class="knowledge-search">
                                <UiIcon Name="search" />
                                <input type="search" @ref="_searchInput" value="@Search" @oninput="ChangeSearch" maxlength="@SearchLimit"
                                       placeholder="Fx C# eller Control Flow" />
                            </span>
                        </label>
                        <label class="field">
                            Niveau
                            <select value="@Difficulty" @onchange="ChangeDifficulty">
                                <option value="">Alle niveauer</option>
                                @foreach (var difficulty in Difficulties)
                                {
                                    <option value="@difficulty">@difficulty</option>
                                }
                            </select>
                        </label>
                    </div>
                </div>
                <div class="knowledge-result-bar">
                    <p role="status">@QuizCountLabel(items.Length)</p>
                    @if (HasFilters)
                    {
                        <button type="button" class="knowledge-text-button" @onclick="ClearFilters">Ryd filtre</button>
                    }
                </div>
                @if (items.Length == 0)
                {
                    <p class="panel knowledge-empty">@(HasFilters ? "Ingen øvelser matcher din søgning." : "Der er endnu ingen frie øvelser.")</p>
                }
                else
                {
                    <div class="knowledge-grid">
                        @foreach (var publication in items)
                        {
                            var starting = _startingPublication == publication.Id;
                            <article class="panel knowledge-card" @key="publication.Id">
                                <div class="knowledge-card-body">
                                    <h3>@publication.Title</h3>
                                    @if (!string.IsNullOrWhiteSpace(publication.Description))
                                    {
                                        <p class="knowledge-description">@publication.Description</p>
                                    }
                                    <p class="knowledge-row-meta">
                                        <span>@string.Join(", ", TopicsOf(publication))</span>
                                        @if (publication.LegacyDiscovery is { } discovery)
                                        {
                                            <span>@discovery.Difficulty</span>
                                        }
                                        <span>@QuestionLabel(publication.QuestionCount)</span>
                                        @if (publication.EstimatedMinutes is > 0)
                                        {
                                            <span>@publication.EstimatedMinutes min.</span>
                                        }
                                    </p>
                                </div>
                                <div class="knowledge-card-footer">
                                    @if (_startErrors.TryGetValue(publication.Id, out var error))
                                    {
                                        <p class="knowledge-start-error" role="alert">@error</p>
                                    }
                                    <div class="knowledge-card-actions">
                                        @if (publication.ActiveAttemptId is Guid active)
                                        {
                                            <a class="action" href="@PracticeRunnerUrl(publication.Id, active)">Fortsæt<span class="visually-hidden"> @publication.Title</span></a>
                                        }
                                        else
                                        {
                                            <button type="button" class="action" disabled="@(_startingPublication is not null)" @onclick="() => StartPracticeAsync(publication)">
                                                @(starting ? "Åbner quiz…" : publication.LatestAttemptId is null ? "Start quiz" : "Prøv igen")<span class="visually-hidden"> @publication.Title</span>
                                            </button>
                                            @if (publication.LatestAttemptId is Guid previous)
                                            {
                                                <a class="knowledge-history-link" href="@PracticeRunnerUrl(publication.Id, previous)">Se seneste forsøg<span class="visually-hidden"> for @publication.Title</span></a>
                                            }
                                        }
                                    </div>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>
        }
    }
</div>
