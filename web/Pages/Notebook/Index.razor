@page "/notebook"
@page "/notebook/{PageId:guid}"
@page "/journal"
@page "/teacher/notebook-templates"
@page "/teacher/notebook-templates/{TemplateId:guid}"
@inherits NotebookWorkspacePage
@implements IAsyncDisposable
@using Mercantec.Tech.Web.Notion

<PageTitle>@Heading · LUP</PageTitle>
<NavigationLock OnBeforeInternalNavigation="BeforeNavigation" />
<link rel="stylesheet" href="@EditorAssets.Style" />
@if (!Auth.IsInitialized) { <p role="status">Indlæser…</p> }
else if (!Auth.IsAuthenticated) { <section class="panel"><h1>Din notesbog</h1><p>Log ind for at skrive noter og logbog.</p><a class="action" href="@Auth.LoginPath()">Log ind</a></section> }
else if (ViewAs.IsActive) { <section class="panel"><h1>Notesbøger</h1><p>Afslut elevvisningen for at åbne elevens notesbog med din egen underviseradgang.</p><a class="secondary" href="/teacher/notebooks">Elevnotesbøger</a></section> }
else
{
    @if (_error is not null) { <div class="nb-message nb-error" role="alert">@_error @if (_comment.Length > 0 || _commentDrafts.Count > 0) { <button type="button" class="secondary" @onclick="DiscardCommentDrafts">Kassér kommentarudkast</button> }</div> }
    @if (_notice is not null) { <p class="nb-message" role="status">@_notice</p> }
    @if (_loading) { <p role="status">Henter notesbogen…</p> }
    else if (!TemplateMode || IsTeacher)
    {
        <div @ref="_workspaceElement" class="notion-workspace nb-workspace @(_sidebarOpen ? "sidebar-open" : null) @(_workspaceFocused ? "notion-focus-mode" : null)" data-can-create-page="@(ShortcutCanCreatePage ? "true" : "false")" data-can-create-child="@(ShortcutCanCreateChild ? "true" : "false")" data-edge-to-edge="true" data-sidebar-ready="@_sidebarReady.ToString().ToLowerInvariant()" data-focus-mode="@_workspaceFocused.ToString().ToLowerInvariant()">
            @if (_sidebarOpen)
            {
                <button type="button" class="notion-sidebar-backdrop" tabindex="-1" aria-label="Luk sidemenu" @onclick="() => SetSidebarOpen(false)"></button>
            }
            <aside id="notion-sidebar" class="notion-sidebar nb-sidebar @(_sidebarOpen ? "is-open" : null)" tabindex="-1" hidden="@(!_sidebarOpen)" role="@(_sidebarMobile && _sidebarOpen ? "dialog" : null)" aria-modal="@(_sidebarMobile && _sidebarOpen ? "true" : null)" aria-label="Notesbogens sider">
                <div class="notion-sidebar-heading">
                    <div><span class="notion-sidebar-eyebrow">@Heading</span><h2>@(TemplateMode ? "Skabeloner" : "Sider")</h2></div>
                    <button type="button" class="notion-icon-button notion-sidebar-close" aria-label="Skjul sidemenu" title="Skjul sidemenu" @onclick="() => SetSidebarOpen(false)"><UiIcon Name="panel" /></button>
                </div>
                <div class="notion-page-search">
                    <UiIcon Name="search" /><label class="notion-visually-hidden" for="notion-page-search">@(TemplateMode ? "Find en skabelon" : "Find en side")</label>
                    <input id="notion-page-search" type="search" aria-keyshortcuts="Control+p Meta+p" value="@(TemplateMode ? _templateSearch : _search)" @oninput="SearchPages" @onkeydown="SearchKeyDown" placeholder="@(TemplateMode ? "Find en skabelon…" : "Find en side…")" autocomplete="off" />
                    @if ((TemplateMode ? _templateSearch : _search).Length > 0)
                    {
                        <button type="button" class="notion-icon-button" aria-label="Ryd sidesøgning" @onclick="ClearSearch"><UiIcon Name="close" /></button>
                    }
                </div>
                @if (Own || TemplateMode)
                {
                    <div class="notion-actions notion-tree-actions">
                        <button type="button" class="notion-sidebar-create" aria-keyshortcuts="Control+Alt+n Meta+Alt+n" @onclick="() => BeginCreate(false)" disabled="@_busy"><UiIcon Name="plus" />@(TemplateMode ? "Ny skabelon" : "Ny note")</button>
                        @if (!TemplateMode)
                        {
                            <button type="button" class="secondary" @onclick="OpenTreeTrash" disabled="@_busy">Papirkurv</button>
                        }
                    </div>
                }
                @if (TemplateMode)
                {
                    <div class="notion-page-list-heading"><span>@(_templateSearch.Trim().Length > 0 ? "Søgeresultater" : "Alle skabeloner")</span><span aria-live="polite">@VisibleTemplates.Count()</span></div>
                    <nav class="notion-page-list" aria-label="Logbogsskabeloner">
                        @foreach (var template in VisibleTemplates)
                        {
                            <div class="notion-page-row" data-page-id="@template.Id"><span class="notion-branch-spacer" aria-hidden="true"></span><a class="notion-page nb-page @(TemplateId == template.Id ? "is-current" : null)" href="/teacher/notebook-templates/@template.Id" aria-current="@(TemplateId == template.Id ? "page" : null)"><NotebookPageLabel Title="@template.Title"><small class="notion-page-parent">@CadenceLabel(template.Cadence) · @(template.IsActive ? $"Aktiv v{template.Version}" : "Kladde / arkiveret")</small></NotebookPageLabel></a></div>
                        }
                        @if (!VisibleTemplates.Any()) { <p class="notion-sidebar-empty" role="status">@(_templateSearch.Trim().Length > 0 ? "Ingen skabeloner matcher søgningen." : "Der er ingen skabeloner endnu.")</p> }
                    </nav>
                }
                else
                {
                    @if (_draggingPage is not null) { <NotebookTreeRootDrop OnDrop="DropTreePage" /> }
                    <div class="notion-page-list-heading"><span>@(HasFilters ? "Søgeresultater" : "Alle sider")</span><span aria-live="polite">@PageCount</span></div>
                    <nav class="notion-page-list" aria-label="Sider i notesbogen" aria-busy="@(_filtering ? "true" : "false")">
                        @if (_sidebarOpen)
                        {
                            var rows = OrderedPages();
                            @if (rows.Count > 60)
                            {
                                @if (_activeRow is not null) { <div class="notion-current-page"><span>Du er her</span>@PageRowContent(_activeRow)</div> }
                                <Virtualize Items="_virtualRows" Context="item" ItemSize="44" OverscanCount="4">@PageRowContent(item)</Virtualize>
                            }
                            else { @foreach (var item in rows) { @PageRowContent(item) } }
                        }
                        @if (PageCount == 0 && !_filtering) { <p class="notion-sidebar-empty" role="status">@(HasFilters ? "Ingen sider matcher dine filtre." : "Din første side starter her.")</p> }
                    </nav>
                    @if (_pages.Length < _total && (HasFilters || _current is null)) { <button class="secondary" disabled="@(_busy || _filtering)" @onclick="() => Filter(more: true)">Vis flere sider</button> }
                }
                @if (_creating)
                {
                    <form class="nb-create-form" @onsubmit="Create" @onsubmit:preventDefault><h3>@(TemplateMode ? "Ny skabelon" : _newParent is null ? "Ny note" : "Ny underside")</h3><label>Titel<input @bind="_newTitle" @bind:event="oninput" maxlength="200" required autofocus /></label>@if (TemplateMode) { <label>Rytme<select @bind="_newCadence"><option value="daily">Daglig</option><option value="weekly">Ugentlig</option><option value="free">Fri</option></select></label> }<div class="nb-actions"><button class="action" disabled="@(_busy || string.IsNullOrWhiteSpace(_newTitle))">Opret</button><button type="button" class="secondary" @onclick="() => _creating = false">Annullér</button></div></form>
                }
                <details class="notion-sidebar-tools"><summary><UiIcon Name="sliders" />Notesbogsværktøjer<span aria-hidden="true">⌄</span></summary>
                    <nav aria-label="Notesbogsværktøjer">
                        <a href="/notes"><UiIcon Name="book" />Alle notesbøger</a>
                        @if (!Own) { <a href="/notebook"><UiIcon Name="book" />Min notesbog</a> }
                        @if (NotebookLanding && _current is { } firstPage)
                        {
                            <a href="@PageHref(firstPage.DocumentId)"><UiIcon Name="file" />Åbn noten som side</a>
                        }
                        else if (!TemplateMode && !NotebookLanding && _loadedNotebookAccess is Guid bookId)
                        {
                            <a href="@NotebookHref(bookId)"><UiIcon Name="book" />Åbn notesbogen</a>
                        }
                        @if (!TemplateMode && _notebookId is not null) { <button type="button" disabled="@_busy" @onclick="ShowGraph"><UiIcon Name="chart" />Åbn forbindelser og graf</button> }
                        @if (Own && !TemplateMode) { <button type="button" disabled="@_busy" @onclick="ToggleJournal"><UiIcon Name="plus" />Ny logbog</button> }
                        @if (IsTeacher)
                        {
                            <a href="/teacher/notebooks"><UiIcon Name="people" />Elevnotesbøger</a>
                            @if (!TemplateMode) { <a href="/teacher/notebook-templates"><UiIcon Name="file" />Skabeloner</a> }
                        }
                        <button type="button" disabled="@_busy" @onclick="Reload"><UiIcon Name="loop" />Opdatér</button>
                    </nav>
                </details>
                @if (!TemplateMode)
                {
                    <details class="notion-sidebar-tools"><summary><UiIcon Name="search" />Filtre<span aria-hidden="true">⌄</span></summary>
                        <form class="nb-filters" @onsubmit="() => Filter()" @onsubmit:preventDefault>
                            <div class="nb-filter-row"><label>Type<select @bind="_kind" @bind:after="ApplyFilters"><option value="">Alle sider</option><option value="note">Noter</option><option value="journal">Logbog</option></select></label><label>Tag<input @bind="_tag" @bind:event="oninput" @bind:after="QueueFilter" placeholder="Alle tags" /></label></div>
                        </form>
                    </details>
                    @if (_shared.Length > 0)
                    {
                        <details class="notion-sidebar-tools"><summary><UiIcon Name="people" />Delt med mig (@_shared.Length)<span aria-hidden="true">⌄</span></summary>
                            <nav aria-label="Delt med mig">@foreach (var shared in _shared) { <a href="/notebook/@shared.Id"><UiIcon Name="file" /><EmojiText Text="@shared.Title" /></a> }</nav>
                        </details>
                    }
                }
                <div class="notion-sidebar-resize" role="separator" aria-label="Sideoversigtens bredde" aria-orientation="vertical" aria-valuemin="180" aria-valuemax="420" aria-valuenow="268" tabindex="0"></div>
            </aside>
            <section class="notion-document nb-document" tabindex="-1" aria-label="Dokumentside">
                <div class="notion-document-toolbar">
                    <h1 class="notion-visually-hidden">@Heading</h1>
                    <div class="notion-toolbar-nav">
                        <button type="button" class="notion-sidebar-toggle nb-sidebar-toggle" aria-controls="notion-sidebar" aria-keyshortcuts="Control+b Meta+b" aria-expanded="@(_sidebarOpen && !_workspaceFocused ? "true" : "false")" aria-label="@(_sidebarOpen && !_workspaceFocused ? "Skjul sidemenu" : "Vis sidemenu")" title="@(_sidebarOpen && !_workspaceFocused ? "Skjul sidemenu" : "Vis sidemenu")" @onclick="ToggleSidebar"><UiIcon Name="panel" /><span>Sider</span></button>
                        <button type="button" class="notion-focus-toggle" disabled="@(!SidebarEnhanced)" aria-pressed="@(_workspaceFocused ? "true" : "false")" aria-label="@(_workspaceFocused ? "Afslut fokus" : "Fokus")" title="@(_workspaceFocused ? "Afslut fokus" : "Fokus")" @onclick="ToggleWorkspaceFocus"><UiIcon Name="screen" /><span>@(_workspaceFocused ? "Afslut fokus" : "Fokus")</span></button>
                        <NotebookShortcutHelp @ref="_shortcutHelp" CanCreatePage="ShortcutCanCreatePage" CanCreateChild="ShortcutCanCreateChild" Templates="TemplateMode" CreateLabel="@(TemplateMode ? "Opret skabelon" : "Opret note")" />
                    </div>
                    <div class="notion-toolbar-title notion-published-title"><EmojiText Text="@(_current?.Title ?? Heading)" /></div>
                    @if (_current is not null || CanEditCover)
                    {
                        <div class="notion-toolbar-actions">
                            @if (_current is not null)
                            {
                                <span class="notion-save-status nb-save @_status" role="status" title="@(Editing ? StatusLabel : "Læsevisning · opdateres automatisk")"><i aria-hidden="true"></i><span class="notion-save-label">@(Editing ? StatusLabel : "Læsevisning")</span></span>
                            }
                            @if (CanEditCover)
                            {
                                <details class="notion-document-more">
                                    <summary aria-label="Flere sidehandlinger"><UiIcon Name="more" /><span>Mere</span></summary>
                                    <div class="notion-document-menu notion-menu-group">
                                        @if (NotebookLanding && _loadedNotebookAccess is Guid coverBook)
                                        {
                                            <NotebookCoverActions @key='("notebook", coverBook)' Kind="notebook" TargetId="coverBook" CoverId="NotebookCoverId"
                                                                  CoverChanged="coverId => UpdateNotebookCover(coverBook, coverId)" BeforeGenerate="PrepareCoverGeneration" AdjustRequested="() => _coverEditor?.AdjustPosition()" />
                                        }
                                        else if (_current is { } coverPage)
                                        {
                                            <NotebookCoverActions @key='("notebook-page", coverPage.DocumentId)' Kind="notebook-page" TargetId="coverPage.DocumentId" CoverId="coverPage.CoverId"
                                                                  CoverChanged="coverId => UpdatePageCover(coverPage.DocumentId, coverId)" BeforeGenerate="PrepareCoverGeneration" AdjustRequested="() => _coverEditor?.AdjustPosition()" />
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    }
                </div>
                @if (_showJournal && Own)
                {
                    <section class="nb-journal-library" aria-labelledby="nb-journal-title"><div class="nb-sidebar-title"><h2 id="nb-journal-title">Skriv logbog</h2><button class="secondary" @onclick="() => _showJournal = false">Luk</button></div><p>Vælg en skabelon. Et dagligt eller ugentligt indlæg åbnes igen, hvis du allerede har skrevet i perioden.</p><div class="nb-meta-grid"><label>Dato<input type="date" @bind="_period" /></label><label>Hold (valgfrit)<select @bind="_entryHold"><option value="">Uden hold</option>@foreach (var hold in _holds) { <option value="@hold.Id">@hold.Name</option> }</select></label></div><div class="nb-template-cards">@foreach (var template in _templates.Where(t => t.IsActive)) { <button class="nb-template-card" disabled="@_busy" @onclick="() => Entry(template.Id)"><strong>@template.Title</strong><span>@CadenceLabel(template.Cadence)</span></button> }</div>@if (!_templates.Any(t => t.IsActive)) { <p class="nb-muted">Der er endnu ingen aktive skabeloner. Din underviser kan oprette dem.</p> }</section>
                }
                @if (_showGraph && _notebookId is not null)
                {
                    <section class="nb-graph-panel"><div class="nb-sidebar-title"><h2>Forbindelser mellem sider</h2><button class="secondary" @onclick="() => _showGraph = false">Luk grafen</button></div><ReferenceGraphView ScopeKind="notebook" ScopeId="@_notebookId.ToString()" /></section>
                }
                @if (_current is null)
                {
                    @CoverBanner
                    <div class="nb-empty"><UiIcon Name="book" /><h2>Ingen sider</h2><p>@(TemplateMode ? "Opret eller vælg en skabelon." : "Opret en note eller vælg en logbogsskabelon.")</p>@if (Own) { <button class="action" @onclick="() => BeginCreate(false)">Opret første note</button> }</div>
                }
                else
                {
                    <article class="nb-sheet">
                    @CoverBanner
                    <div class="nb-document-bar"><div class="nb-actions">@if (Editing && !TemplateMode) { <button class="secondary" aria-keyshortcuts="Control+Alt+Shift+n Meta+Alt+Shift+n" @onclick="() => BeginCreate(true)" disabled="@_busy">Ny underside</button> }@if (_current.CanComment) { <button class="secondary" @onclick="ToggleComments" disabled="@_busy" aria-expanded="@_showComments">Kommentarer</button> }@if (Own) { <button class="secondary" @onclick="ToggleShares" disabled="@_busy" aria-expanded="@_showShares">Del</button> }</div></div>
                    <p class="nb-visibility">@(TemplateMode ? "Undervisere kan skrive i skabelonen. Elever får en kopi ved oprettelse af logbog." : "Alle undervisere kan læse og kommentere. Deling giver andre læseadgang.")</p>
                    @if (_status is "offline" or "error" && _statusDetail.Length > 0) { <p class="nb-message nb-error" role="alert">@_statusDetail</p> }
                    @if (Editing)
                    {
                        <form class="nb-metadata" @onsubmit="SaveMetadata" @onsubmit:preventDefault><label class="nb-title-label">Titel<input class="nb-title-input" @bind="_title" @bind:event="oninput" maxlength="200" required /></label><details><summary>Sidens oplysninger</summary><div class="nb-meta-grid">@if (TemplateMode) { <label>Rytme<select @bind="_cadence"><option value="daily">Daglig</option><option value="weekly">Ugentlig</option><option value="free">Fri</option></select></label> } else { <label>Tags · adskil med komma<input @bind="_tags" @bind:event="oninput" placeholder="csharp, database" /></label> }</div></details>@if (MetadataDirty) { <div class="nb-actions"><button class="action" disabled="@(_busy || string.IsNullOrWhiteSpace(_title))">Gem oplysninger</button><button type="button" class="secondary" @onclick="ResetMetadata">Annullér ændringer</button></div> }</form>
                    }
                    else { <header class="nb-reader-title"><h2>@_current.Title</h2>@if (_current.PeriodStart is { } period) { <p>@period.ToString("d. MMMM yyyy")</p> }@if (_current.Tags.Length > 0) { <div class="nb-tags">@foreach (var tag in _current.Tags) { <span>#@tag</span> }</div> }</header> }
                    @if (TemplateMode && CurrentTemplate is { } currentTemplate)
                    {
                        <div class="nb-template-status"><div><strong>@(currentTemplate.IsActive ? $"Aktiv · version {currentTemplate.Version}" : "Kladde / arkiveret")</strong><p>Gem oplysninger og indhold før aktivering. Ændringer bruges først i nye indlæg, når du aktiverer igen.</p></div><div class="nb-actions"><button class="action" disabled="@(_busy || !_mounted || MetadataDirty || _status is "connecting" or "saving" or "offline" or "error")" @onclick="Activate">@(currentTemplate.IsActive ? "Aktivér ny version" : "Aktivér skabelon")</button>@if (currentTemplate.IsActive) { <button class="secondary" disabled="@_busy" @onclick="Archive">Arkivér</button> }</div></div>
                    }
                    <div class="nb-editor-root" @ref="_editorElement"></div>@if (NoticeKind == "mention" && !string.IsNullOrEmpty(NoticeQuery)) { <MentionReceipt SourceId="_current.DocumentId" Loaded="_mounted" Notice="@NoticeQuery" /> }
                    @if (!Editing && !_mounted) { <p class="nb-muted nb-waiting" role="status">Venter på sidens gemte indhold…</p> }
                    </article>
                    @if (_showComments && _current.CanComment)
                    {
                        <section class="nb-comments"><div class="nb-sidebar-title"><h2>Kommentarer</h2><button class="secondary" @onclick="() => _showComments = false">Luk</button></div><p class="nb-muted">Kommentarer deles mellem eleven og underviserne.</p>@foreach (var comment in _comments.OrderBy(c => c.CreatedAtUtc)) { <article class="nb-comment"><header><strong>@comment.AuthorName</strong><time datetime="@comment.CreatedAtUtc.ToString("O")">@comment.CreatedAtUtc.ToLocalTime().ToString("d. MMM HH:mm")</time></header><p>@comment.Text</p></article> }@if (_comments.Length == 0) { <p class="nb-muted">Der er ingen kommentarer endnu.</p> }<form @onsubmit="AddComment" @onsubmit:preventDefault><label>Skriv en kommentar<textarea @bind="_comment" @bind:event="oninput" maxlength="4000" rows="3"></textarea></label><button class="action" disabled="@(_busy || string.IsNullOrWhiteSpace(_comment))">Tilføj kommentar</button></form></section>
                    }
                    @if (_showShares && Own)
                    {
                        <section class="nb-sharing"><div class="nb-sidebar-title"><h2>Del med en LUP-bruger</h2><button class="secondary" @onclick="() => _showShares = false">Luk</button></div><p>Undervisere har altid læse- og kommentaradgang. Andre får kun læseadgang til det, du vælger.</p><label>Hvad vil du dele?<select @bind="_shareScope"><option value="page">Denne side · uden undersider</option><option value="notebook">Hele notesbogen · også fremtidige sider</option></select></label><form class="nb-search-user" @onsubmit="SearchUsers" @onsubmit:preventDefault><label>Find person<input type="search" @bind="_userSearch" @bind:event="oninput" placeholder="Navn i LUP" /></label><button class="secondary" disabled="@(_busy || _userSearch.Trim().Length < 2)">Find</button></form><div class="nb-user-results">@foreach (var user in _users.Where(u => u.Sub.ToString() != Auth.Subject)) { <div class="nb-share-row"><span><strong>@user.DisplayName</strong><small>@(user.IsTeacher ? "Underviser" : "LUP-bruger")</small></span><button class="secondary" disabled="@_busy" @onclick="() => Share(user.Sub)">Giv læseadgang</button></div> }</div>@if (_usersSearched && !_users.Any(u => u.Sub.ToString() != Auth.Subject)) { <p class="nb-muted">Ingen LUP-brugere matcher navnet. Prøv et andet navn.</p> }<h3>Aktuelle delinger</h3>@if (_shares.Length == 0) { <p class="nb-muted">Ingen ekstra delinger.</p> }@foreach (var share in _shares) { <div class="nb-share-row"><span><strong>@share.RecipientName</strong><small>@(share.PageId is null ? "Hele notesbogen" : _current.Pages.FirstOrDefault(p => p.Id == share.PageId)?.Title ?? "En side")</small></span><button class="secondary" disabled="@_busy" @onclick="() => Revoke(share.Id)">Fjern adgang</button></div> }</section>
                    }
                }
            </section>
        </div>
        @if (Own && !TemplateMode)
        {
            <NotebookTreeDialogs @ref="_treeDialogs" Items="@TreeItems" Reorder="CanReorderTree"
                                 OnCreateChild="CreateTreeChild" SetPageIcon="SetPageIcon" MovePage="MoveTreePage" PreviewDelete="PreviewTreeDelete"
                                 DeletePage="DeleteTreePage" ListTrash="ListTreeTrash" RestorePage="RestoreTreePage" />
        }
    }
}

@code {
    private NotebookCoverEditor? _coverEditor;

    private RenderFragment CoverBanner => @<text>
        @if (NotebookLanding && _loadedNotebookAccess is Guid bookId)
        {
            <NotebookCoverEditor @ref="_coverEditor" @key='("notebook", bookId)' Kind="notebook" TargetId="bookId" CoverId="NotebookCoverId"
                                 CanAdjust="@CanEditCover" CoverChanged="coverId => UpdateNotebookCover(bookId, coverId)" />
        }
        else if (!TemplateMode && _current is { } page)
        {
            <NotebookCoverEditor @ref="_coverEditor" @key='("notebook-page", page.DocumentId)' Kind="notebook-page" TargetId="page.DocumentId" CoverId="page.CoverId"
                                 CanAdjust="@CanEditCover" CoverChanged="coverId => UpdatePageCover(page.DocumentId, coverId)" />
        }
    </text>;

    private RenderFragment PageRowContent(SidebarRow item) => @<NotebookTreeRow @key="item.Page.Id" Id="@item.Page.Id" Title="@item.Page.Title" Editable="Own"
                     Busy="_busy" Reorder="CanReorderTree" Dragging="_draggingPage"
                     OnActions="OpenTreeActions" OnDragStart="StartTreeDrag" OnDragEnd="EndTreeDrag" OnDrop="DropTreePage">
        <div class="notion-page-row" style="--page-depth:@item.Depth">
            @if (item.HasChildren && !HasFilters)
            {
                <button type="button" class="notion-branch-toggle @(_expandedPages.Contains(item.Page.Id) ? "is-expanded" : null)" aria-expanded="@(_expandedPages.Contains(item.Page.Id) ? "true" : "false")" aria-label="@($"Fold {item.Page.Title} {(_expandedPages.Contains(item.Page.Id) ? "sammen" : "ud")}")" @onclick="() => ToggleBranch(item.Page.Id)"><UiIcon Name="chevron" /></button>
            }
            else { <span class="notion-branch-spacer" aria-hidden="true"></span> }
            <button type="button" class="notion-page nb-page @(item.Page.Id == _current?.DocumentId ? "is-current" : null)" title="@item.Page.Title" aria-current="@(item.Page.Id == _current?.DocumentId ? "page" : null)" @onclick="() => OpenPage(item.Page.Id)">
                <NotebookPageLabel Title="@item.Page.Title" IconEmojiId="item.Page.IconEmojiId" HasChildren="item.HasChildren">
                    @if (item.Detail is string detail) { <small class="notion-page-parent">@detail</small> }
                </NotebookPageLabel>
            </button>
        </div>
    </NotebookTreeRow>;
}
