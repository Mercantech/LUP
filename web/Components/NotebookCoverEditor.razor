@if (CoverId is not null || CanEdit)
{
    <div class="notebook-cover-editor">
        @if (CoverId is not null)
        {
            <div class="notebook-cover-banner">
                <NotebookCoverImage Kind="@Kind" TargetId="@TargetId" CoverId="@CoverId" PublishedOnly="@PublishedOnly" />
            </div>
        }
        @if (CanEdit)
        {
            <NotebookCoverActions @key="(Kind, TargetId)" Kind="@Kind" TargetId="@TargetId" CoverId="@CoverId"
                                  CoverChanged="@CoverChanged" BeforeGenerate="@BeforeGenerate" />
        }
    </div>
}

@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = "";
    [Parameter, EditorRequired] public Guid TargetId { get; set; }
    [Parameter] public Guid? CoverId { get; set; }
    [Parameter] public bool PublishedOnly { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback<Guid?> CoverChanged { get; set; }
    [Parameter] public EventCallback BeforeGenerate { get; set; }
}
