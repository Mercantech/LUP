@inject IJSRuntime Js
@implements IAsyncDisposable

@if (!HideTrigger)
{
    <button class="shortcut-trigger" type="button" title="Tastaturgenveje (F1)"
            aria-label="Tastaturgenveje" aria-haspopup="dialog" aria-keyshortcuts="F1" @onclick="OpenAsync">
        <UiIcon Name="keyboard" />
    </button>
}
<dialog @ref="_dialog" class="notebook-shortcut-help" aria-labelledby="notebook-shortcuts-title">
    <header>
        <h2 id="notebook-shortcuts-title">Tastaturgenveje</h2>
        <form method="dialog"><button type="submit" autofocus aria-label="Luk tastaturgenveje" title="Luk (Esc)"><UiIcon Name="close" /></button></form>
    </header>
    <section>
        <h3>Sideoversigt</h3>
        <dl>
            <div><dt>@(Templates ? "Find en skabelon" : "Find en side")<small>Skriv din søgning, og tryk Enter for at åbne første resultat.</small></dt><dd>@Primary <kbd>P</kbd></dd></div>
            <div><dt>Gå til sidelisten</dt><dd>@Primary <kbd>Skift</kbd> <kbd>E</kbd></dd></div>
            <div><dt>Vis eller skjul sidepanelet <small>Uden for skrivefelter</small></dt><dd>@Primary <kbd>B</kbd></dd></div>
            @if (CanCreatePage)
            {
                <div><dt>@CreateLabel</dt><dd>@Primary @Alternate <kbd>N</kbd></dd></div>
            }
            @if (CanCreateChild)
            {
                <div><dt>Opret underside</dt><dd>@Primary @Alternate <kbd>Skift</kbd> <kbd>N</kbd></dd></div>
            }
            <div><dt>Vis tastaturgenveje</dt><dd><kbd>F1</kbd></dd></div>
        </dl>
    </section>
    <section>
        <h3>I sidelisten</h3>
        <dl>
            <div><dt>Forrige eller næste side</dt><dd><kbd aria-label="Pil op">↑</kbd> / <kbd aria-label="Pil ned">↓</kbd></dd></div>
            <div><dt>Første eller sidste side</dt><dd><kbd>Home</kbd> / <kbd>End</kbd></dd></div>
            @if (!Templates)
            {
                <div><dt>Fold sammen eller gå til den overordnede side</dt><dd><kbd aria-label="Pil venstre">←</kbd></dd></div>
                <div><dt>Fold ud eller gå til første underside</dt><dd><kbd aria-label="Pil højre">→</kbd></dd></div>
            }
            <div><dt>Åbn den markerede side</dt><dd><kbd>Enter</kbd></dd></div>
            <div><dt>Gå tilbage til dokumentet</dt><dd><kbd>Esc</kbd></dd></div>
        </dl>
    </section>
</dialog>

@code {
    [Parameter] public bool CanCreatePage { get; set; }
    [Parameter] public bool CanCreateChild { get; set; }
    [Parameter] public bool HideTrigger { get; set; }
    [Parameter] public bool Templates { get; set; }
    [Parameter] public string CreateLabel { get; set; } = "Opret side";

    private RenderFragment Primary => @<kbd><span class="key-pc">Ctrl</span><span class="key-mac">Cmd</span></kbd>;
    private RenderFragment Alternate => @<kbd><span class="key-pc">Alt</span><span class="key-mac">Option</span></kbd>;
    private ElementReference _dialog;
    private Task<IJSObjectReference>? _module;
    private bool _disposed;

    public async Task OpenAsync()
    {
        if (_disposed) return;
        _module ??= Js.InvokeAsync<IJSObjectReference>("import", "./js/modal-dialog.js").AsTask();
        var module = await _module;
        if (!_disposed) await module.InvokeVoidAsync("open", _dialog);
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is null) return;
        try { await (await _module).DisposeAsync(); }
        catch (JSDisconnectedException) { }
    }
}
