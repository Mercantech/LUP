<nav class="breadcrumbs" aria-label="Brødkrummer"><a href="/library?category=badges">Oversigt</a><span>›</span><span aria-current="page">Badges og krav</span></nav>
<header class="page-title"><div><h1>Badges og krav</h1><p>Vælg et badge for at se, hvad du skal gøre for at opnå det.</p></div>@if (ShowCollectionLink) { <a class="secondary" href="/progress/badges">Mine badges</a> }</header>
@foreach (var automatic in new[] { true, false })
{
    <h2>@(automatic ? "Automatiske badges" : "Badges med underviserens godkendelse")</h2>
    <div class="badge-shelf">@foreach (var badge in BadgeCatalog.All.Where(b => b.Automatic == automatic)) { <BadgeTile Badge="badge" /> }</div>
}
@code { [Parameter] public bool ShowCollectionLink { get; set; } }