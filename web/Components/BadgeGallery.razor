@inject HttpClient Http
@if (_error) { <p role="alert">Samlingen kunne ikke hentes.</p><button class="secondary" @onclick="Load">Prøv igen</button> }
else if (_entries is null) { <p role="status">Henter dine badges…</p> }
else {
    var earned = _entries.Where(e => e.Status == "earned").DistinctBy(e => e.BadgeId).ToArray();
    <h2>Opnåede badges (@earned.Length)</h2>
    @if (earned.Length == 0) { <p>Din samling starter med din første præstation. <a href="/badges/first-submission">Se, hvordan du får Første aflevering.</a></p> }
    <div class="badge-shelf">@foreach (var entry in earned) { <BadgeTile Badge="BadgeCatalog.Find(entry.BadgeId)!" Entry="entry" /> }</div>
    @if (_entries.Any(e => e.Status != "earned")) {
        <h2>Dine anmodninger</h2>
        <div class="badge-shelf">@foreach (var entry in _entries.Where(e => e.Status != "earned")) { <BadgeTile Badge="BadgeCatalog.Find(entry.BadgeId)!" Entry="entry" /> }</div>
    }
}
@code {
    private BadgeEntry[]? _entries;
    private bool _error;
    protected override Task OnInitializedAsync() => Load();
    private async Task Load() {
        _error = false;
        try { _entries = (await Http.GetFromJsonAsync<BadgeCollection>("badges/mine"))!.Entries; }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException) { _error = true; }
    }
}