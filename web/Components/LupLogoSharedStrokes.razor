<svg class="shared-strokes @(Animate ? "is-playing" : null)" viewBox="-18 -17 46 34"
     aria-hidden="true" focusable="false">
    <g class="shared-source" shape-rendering="crispEdges">
        <use href="images/branding/pixel-lup.svg?v=2#mark" transform="translate(1.5 -14) scale(.7)" />
        <path class="shared-branches" d="M5 -5v2m-15 0h30m-30 0v1m15-1v1m15-1v1" />
    </g>
    <g shape-rendering="crispEdges">
        <use class="shared-original" href="images/branding/pixel-lup.svg?v=2#mark" />
        <g class="shared-letter shared-letter-l">
            <use class="shared-detail" href="images/branding/pixel-lup.svg?v=2#letter-l" />
            <svg viewBox="0 0 2 10" width="2" height="10" overflow="hidden">
                <use href="images/branding/pixel-lup.svg?v=2#letter-l" />
            </svg>
        </g>
        <g class="shared-letter shared-letter-u">
            <use class="shared-detail" href="images/branding/pixel-lup.svg?v=2#letter-l" />
            <use class="shared-detail" href="images/branding/pixel-lup.svg?v=2#letter-u" />
            <svg viewBox="0 0 2 10" width="2" height="10" overflow="hidden">
                <use href="images/branding/pixel-lup.svg?v=2#letter-l" />
            </svg>
        </g>
        <g class="shared-letter shared-letter-p">
            <use class="shared-detail" href="images/branding/pixel-lup.svg?v=2#letter-p" />
            <svg viewBox="0 0 2 10" width="2" height="10" overflow="hidden">
                <use href="images/branding/pixel-lup.svg?v=2#letter-l" />
            </svg>
        </g>
    </g>
    <g class="shared-captions" text-anchor="middle">
        <text x="-10" y="14.5">L</text>
        <text x="5" y="14.5">U</text>
        <text x="20" y="14.5">P</text>
    </g>
</svg>

@code {
    [Parameter]
    public bool Animate { get; set; } = true;
}
