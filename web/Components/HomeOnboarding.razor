@inject HttpClient Http
@inject IJSRuntime Js
@implements IAsyncDisposable

@if (_steps.Length > 0)
{
    var step = _steps[_stepIndex];
    <dialog @ref="_dialog" class="home-onboarding" aria-labelledby="onboarding-title"
            aria-describedby="onboarding-text" @onclose="DismissAsync">
        <div class="onboarding-mark" aria-hidden="true"><UiIcon Name="book" /></div>
        <div aria-live="polite">
            <h2 id="onboarding-title">@step.Title</h2>
            <p id="onboarding-text">@step.Text</p>
        </div>
        <form method="dialog">
            <button class="secondary" type="submit">Spring over</button>
            @if (_stepIndex + 1 < _steps.Length)
            {
                <button class="action" type="button" autofocus @onclick="() => _stepIndex++">Næste</button>
            }
            else
            {
                <button class="action" type="submit" autofocus>Afslut</button>
            }
        </form>
    </dialog>
}
@if (_saveFailed)
{
    <div class="onboarding-save">
        <p role="status">LUP kunne ikke gemme dit valg.</p>
        <button class="secondary" type="button" disabled="@_saving" @onclick="SaveDismissalAsync">Prøv igen</button>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid Subject { get; set; }

    private const string Endpoint = "me/onboarding";
    private OnboardingStepDto[] _steps = [];
    private int _stepIndex;
    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private bool _openAttempted;
    private bool _disposed;
    private bool _saving;
    private bool _saveFailed;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var steps = await Http.GetFromJsonAsync<OnboardingStepDto[]>(Endpoint);
            if (!_disposed) _steps = steps ?? [];
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException or System.Text.Json.JsonException)
        {
            // Onboarding is optional, so the home page stays usable when the API is unavailable.
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || _steps.Length == 0 || _openAttempted) return;

        _openAttempted = true;
        try
        {
            var module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/modal-dialog.js");
            if (_disposed)
            {
                await module.DisposeAsync();
                return;
            }

            _module = module;
            await module.InvokeVoidAsync("open", _dialog);
        }
        catch (JSException)
        {
            if (!_disposed)
            {
                _steps = [];
                StateHasChanged();
            }
        }
    }

    private async Task DismissAsync()
    {
        if (_disposed || _steps.Length == 0) return;

        _steps = [];
        await SaveDismissalAsync();
    }

    private async Task SaveDismissalAsync()
    {
        _saving = true;
        try
        {
            using var request = new HttpRequestMessage(HttpMethod.Put, Endpoint)
            {
                Content = JsonContent.Create(new DismissOnboardingRequest(Subject))
            };
            request.SetBrowserRequestOption("keepalive", true);
            using var response = await Http.SendAsync(request);
            _saveFailed = !response.IsSuccessStatusCode;
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException)
        {
            _saveFailed = true;
        }
        finally
        {
            _saving = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_module is not null) await _module.DisposeAsync();
    }
}
