@using Mercantec.Tech.Web.Demo
@inject DemoWorld World
@implements IDisposable

@if (!World.Ready)
{
    <p>Indlæser…</p>
}
else
{
    @foreach (var avatar in AvatarCatalog.All.Where(avatar => avatar.Cost > 0))
    {
        <section class="panel" style="margin-bottom:18px">
            <div class="row">
                <AvatarIcon AvatarId="@avatar.Id" Size="48" Decorative="true" />
                <div>
                    <h2>@avatar.Name <span class="pill">@(World.OwnsAvatar(avatar.Id) ? "I din samling" : "Avatar")</span></h2>
                    <p>@avatar.Description</p>
                    <p class="tiny muted">Level @avatar.Level · @avatar.Cost guld · @World.AvatarRequirementText(avatar.Id)</p>
                </div>
                <a class="secondary" href="/profile/character">Se avatarsamlingen</a>
            </div>
        </section>
    }
}

@code {
    protected override async Task OnInitializedAsync()
    {
        World.Changed += OnChanged;
        await World.EnsureAsync();
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);
    public void Dispose() => World.Changed -= OnChanged;
}
