@using Mercantec.Tech.Contracts.HomeGame
@using Mercantec.Tech.Web.HomeGame
@implements IAsyncDisposable
@inject IJSRuntime Js

<div class="home-board-scroll">
    <div class="room-shell" style="@GridStyle">
        <div class="room-wall" aria-hidden="true">
            <img class="room-window" src="images/home-workshop/window.webp" alt="" />
            <img class="room-ledge" src="images/home-workshop/ledge.webp" alt="" />
        </div>
        <div class="home-board @(ReduceMotion ? "motion-reduced" : "") @(Ghost is not null ? "placing" : "")"
             @ref="_board" role="group" aria-label="Boligens grid. Brug piletasterne til at skifte felt.">
            <canvas class="light-map" @ref="_canvas" aria-hidden="true"></canvas>
            @for (var y = 0; y < Layout.Grid.Rows; y++)
            {
                @for (var x = 0; x < Layout.Grid.Columns; x++)
                {
                    var cell = new HomeCell(x, y);
                    _occupants.TryGetValue(cell, out var item);
                    int? lux = _light.TryGetValue(cell, out var reading) ? reading : null;
                    <button @key="cell" type="button" data-x="@x" data-y="@y" data-lux="@lux" tabindex="@(cell == Cursor ? 0 : -1)"
                            class="@CellClass(cell)" aria-label="@CellLabel(cell, item, lux)"
                            @onfocus="() => Visit.InvokeAsync(cell)" @onmouseover="() => Visit.InvokeAsync(cell)"
                            @onclick="() => Activate.InvokeAsync(cell)" @onkeydown="args => OnKeyAsync(args, cell)">
                        @if (Mode == "light" && lux is not null)
                        {
                            <span class="lux-value">@lux lux</span>
                        }
                    </button>
                }
            }
            @foreach (var item in VisibleItems)
            {
                var preview = item == Ghost;
                var sprite = HomeRoomArt.Image(item.DefinitionId);
                <div @key="item.Id" class="furniture @item.DefinitionId @(item.Id == Selected?.Id ? "selected" : "") @(IsPowered(item) ? "powered" : "") @(preview ? "ghost" : "")"
                     data-item-id="@item.Id" data-rotation="@item.Placement!.Rotation" style="@ObjectStyle(item)" aria-hidden="true">
                    @if (sprite is not null)
                    {
                        <img class="object-art" src="@sprite" alt="" draggable="false" />
                    }
                    else
                    {
                        <span class="wall-device"><span class="device-signal">@DeviceMark(item.DefinitionId)</span></span>
                    }
                </div>
            }
            @if (Avatar is { } avatar)
            {
                <div class="resident" style="@ResidentStyle(avatar)" role="img" aria-label="@($"Din avatar: {Character.Name}")"
                     data-avatar-id="@Character.Id" data-activity="@Activity">
                    @if (Character.SpriteAssetRoot is not null || Character.Id == AvatarCatalog.StarterId)
                    {
                        <AvatarSprite AvatarId="@Character.Id" Animation="@Animation" Mini="true" Paused="@ReduceMotion" />
                    }
                    else
                    {
                        <AvatarIcon AvatarId="@Character.Id" Size="96" Decorative="true" />
                    }
                </div>
            }
            @if (Mode == "light" && _reading is { } point)
            {
                <span class="reading-probe @(point.Cell.X >= Layout.Grid.Columns - 2 ? "near-right" : "") @(point.Cell.Y < 2 ? "near-top" : "")"
                      style="@CellPosition(point.Cell)" data-lux="@point.Lux" data-reading-x="@point.Cell.X" data-reading-y="@point.Cell.Y"
                      aria-label="@($"Lys ved bordet: {point.Lux} lux")"><span>@point.Lux lux</span></span>
            }
            <span class="entrance" style="@CellPosition(Layout.Grid.Entry)" aria-hidden="true"></span>
        </div>
    </div>
</div>
