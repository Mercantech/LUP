@using Mercantec.Tech.Contracts.HomeGame
@implements IAsyncDisposable
@inject IJSRuntime Js

<section class="item-actions" role="dialog" aria-label="@Item.Name" popover="manual"
         data-testid="item-actions" data-item-id="@Item.Id" @ref="_panel">
    <header>
        <strong>@Item.Name</strong>
        <button type="button" class="close-actions" aria-label="Luk handlinger" @onclick="CloseAsync">
            <span aria-hidden="true">×</span>
        </button>
    </header>
    <div class="item-action-content">@ChildContent</div>
</section>

@code {
    [Parameter, EditorRequired] public HomeItem Item { get; set; } = default!;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback Dismiss { get; set; }

    private ElementReference _panel;
    private IJSObjectReference? _module;
    private IJSObjectReference? _watch;
    private DotNetObjectReference<HomeItemActions>? _receiver;
    private HomePlacement? _previousPlacement;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var module = await Js.InvokeAsync<IJSObjectReference>("import", "./js/home-item-actions.js?v=2");
            if (_disposed)
            {
                await module.DisposeAsync();
                return;
            }
            _module = module;
            _receiver = DotNetObjectReference.Create(this);
            _previousPlacement = Item.Placement;
            var watch = await module.InvokeAsync<IJSObjectReference?>("open", _panel, Item.Id, _receiver);
            if (_disposed && watch is not null) await ReleaseWatchAsync(watch);
            else _watch = watch;
        }
        else if (_watch is not null && _previousPlacement != Item.Placement)
        {
            _previousPlacement = Item.Placement;
            await _watch.InvokeVoidAsync("reposition");
        }
    }

    private async Task CloseAsync()
    {
        if (_watch is not null) await _watch.InvokeVoidAsync("restoreFocus");
        await Dismiss.InvokeAsync();
    }

    [JSInvokable]
    public Task CloseFromBrowser() => _disposed ? Task.CompletedTask : Dismiss.InvokeAsync();

    private static async ValueTask ReleaseWatchAsync(IJSObjectReference watch)
    {
        await watch.InvokeVoidAsync("dispose");
        await watch.DisposeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        if (_watch is not null) await ReleaseWatchAsync(_watch);
        if (_module is not null) await _module.DisposeAsync();
        _receiver?.Dispose();
    }
}
