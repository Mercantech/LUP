@using Mercantec.Tech.Web.Notebooks
@using Mercantec.Tech.Contracts
@inject NotebookCoverClient Client
@inject AuthService Auth
@inject IJSRuntime Js
@implements IAsyncDisposable

@if (Banner)
{
    <div class="notebook-cover-banner">@ImageContent</div>
    @if (CoverChanged.HasDelegate && !PublishedOnly && _imageUrl is not null && _loadedVersion == CoverId)
    {
        <div class="notebook-cover-position">
            @if (_adjusting)
            {
                <label for="@_rangeId">Lodret udsnit</label>
                <div class="notebook-cover-range">
                    <span>Top</span>
                    <input @ref="_range" id="@_rangeId" type="range" min="0" max="100" @bind="_draftY" @bind:event="oninput" disabled="@_saving" />
                    <span>Bund</span>
                </div>
                <div class="notebook-cover-position-buttons">
                    <button type="button" class="action" @onclick="SavePositionAsync" disabled="@(_saving || _draftY == _positionY)">Gem udsnit</button>
                    <button type="button" class="secondary" @onclick="CancelPosition" disabled="@_saving">Annullér</button>
                </div>
            }
            else
            {
                <button type="button" class="secondary" @onclick="AdjustPosition">Justér udsnit</button>
            }
            @if (_positionError is not null)
            {
                <p role="alert">@_positionError</p>
            }
        </div>
    }
}
else
{
    @ImageContent
}

@code {
    [Parameter, EditorRequired] public string Kind { get; set; } = "";
    [Parameter, EditorRequired] public Guid TargetId { get; set; }
    [Parameter] public Guid? CoverId { get; set; }
    [Parameter] public bool PublishedOnly { get; set; }
    [Parameter] public bool ShowRetry { get; set; }
    [Parameter] public bool Banner { get; set; }
    [Parameter] public EventCallback<Guid?> CoverChanged { get; set; }

    private (string Kind, Guid Target, Guid? Cover, bool PublishedOnly, string? Subject)? _source;
    private CancellationTokenSource? _load;
    private Task<IJSObjectReference>? _module;
    private string? _imageUrl;
    private bool _loadFailed;
    private bool _disposed;
    private readonly string _rangeId = $"cover-position-{Guid.NewGuid():N}";
    private Guid? _loadedVersion;
    private int _positionY = NotebookCoverRules.DefaultPositionY;
    private int _draftY;
    private bool _adjusting;
    private bool _saving;
    private string? _positionError;
    private ElementReference _range;
    private bool _focusRange;

    private RenderFragment ImageContent => @<text>
        @if (_imageUrl is not null)
        {
            <img class="notebook-cover-image" src="@_imageUrl" alt="" decoding="async" draggable="false"
                 style="object-position: 50% @(_adjusting ? _draftY : _positionY)%" />
        }
        else if (_loadFailed && ShowRetry)
        {
            <button type="button" class="secondary notebook-cover-retry" @onclick="() => LoadAsync(retry: true)">Prøv at hente coveret igen</button>
        }
    </text>;

    public void AdjustPosition()
    {
        if (_saving || !CoverChanged.HasDelegate || PublishedOnly) return;
        _draftY = _positionY;
        _positionError = null;
        _adjusting = true;
        _focusRange = true;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusRange || !_adjusting || _imageUrl is null || _loadedVersion != CoverId || _module is null) return;
        _focusRange = false;
        try { await (await _module).InvokeVoidAsync("focusCoverPosition", _range); }
        catch (JSException) { }
    }

    private void CancelPosition()
    {
        _adjusting = false;
        _positionError = null;
    }

    private async Task SavePositionAsync()
    {
        if (_saving || !_adjusting || CoverId is not Guid version || _loadedVersion != version || _load is null
            || !CoverChanged.HasDelegate || PublishedOnly) return;
        var source = _source;
        var ct = _load.Token;
        _saving = true;
        _positionError = null;
        try
        {
            var result = await Client.RepositionAsync(Kind, TargetId, version, _draftY, ct);
            if (ct.IsCancellationRequested || _source != source || Auth.Subject != source?.Subject) return;
            _positionY = result.PositionY;
            _adjusting = false;
            await CoverChanged.InvokeAsync(result.CoverId);
        }
        catch (Exception ex) when (ex is NotebookCoverException or HttpRequestException or System.Text.Json.JsonException or OperationCanceledException)
        {
            if (!ct.IsCancellationRequested && _source == source)
                _positionError = ex is NotebookCoverException ? ex.Message : "Udsnittet kunne ikke gemmes. Prøv igen.";
        }
        finally
        {
            if (_source == source) _saving = false;
        }
    }

    protected override void OnInitialized() => Auth.AuthStateChanged += OnAuthChanged;

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync(bool retry = false)
    {
        var source = (Kind, TargetId, CoverId, PublishedOnly, Auth.Subject);
        if (_disposed || !retry && _source == source) return;
        var samePage = _source is { } previous && previous.Kind == Kind && previous.Target == TargetId
            && previous.PublishedOnly == PublishedOnly && previous.Subject == Auth.Subject;
        _source = source;
        _loadedVersion = null;
        _adjusting = _saving = false;
        _focusRange = false;
        _positionError = null;
        _load?.Cancel();
        _load?.Dispose();
        _load = null;
        _loadFailed = false;
        if (!samePage || CoverId is null || !Auth.IsAuthenticated) await ReplaceImageAsync(null);
        if (_disposed || _source != source || CoverId is not Guid version || TargetId == Guid.Empty || !Auth.IsAuthenticated) return;

        _load = new CancellationTokenSource();
        var ct = _load.Token;
        try
        {
            var image = await Client.ReadAsync(Kind, TargetId, version, PublishedOnly, ct);
            if (ct.IsCancellationRequested || _disposed || _source != source) return;
            if (image is null)
            {
                _loadFailed = true;
                await ReplaceImageAsync(null);
                return;
            }
            _module ??= Js.InvokeAsync<IJSObjectReference>("import", "./js/notebook-covers.js").AsTask();
            var module = await _module;
            if (ct.IsCancellationRequested || _disposed) return;
            var url = await module.InvokeAsync<string>("createCoverUrl", image.Bytes);
            if (ct.IsCancellationRequested || _disposed || _source != source)
                await RevokeAsync(module, url);
            else
            {
                _positionY = image.PositionY;
                if (_adjusting) _draftY = _positionY;
                _loadedVersion = version;
                await ReplaceImageAsync(url);
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or OperationCanceledException or JSException)
        {
            if (_module is { IsFaulted: true }) _module = null;
            if (!ct.IsCancellationRequested && !_disposed && _source == source)
            {
                _loadFailed = true;
                await ReplaceImageAsync(null);
            }
        }
    }

    private async ValueTask ReplaceImageAsync(string? next)
    {
        var old = _imageUrl;
        _imageUrl = next;
        if (old is not null && _module is { IsCompletedSuccessfully: true })
            await RevokeAsync(_module.Result, old);
    }

    private void OnAuthChanged() => _ = InvokeAsync(async () =>
    {
        var loading = LoadAsync();
        StateHasChanged();
        await loading;
        if (!_disposed) StateHasChanged();
    });

    private static async ValueTask RevokeAsync(IJSObjectReference module, string url)
    {
        try { await module.InvokeVoidAsync("revokeCoverUrl", url); }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Auth.AuthStateChanged -= OnAuthChanged;
        _load?.Cancel();
        _load?.Dispose();
        await ReplaceImageAsync(null);
        if (_module is not null)
        {
            try { await (await _module).DisposeAsync(); }
            catch (JSException) { }
        }
    }
}
