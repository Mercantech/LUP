<svg class="lup-logo-assembly @(Animate ? "lup-logo-assembly--animated" : null) @(Loop ? "lup-logo-assembly--loop" : null)"
     viewBox="-3 -3 16 16" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
    <use class="lup-logo-l" href="images/branding/pixel-lup.svg#letter-l" />
    <use class="lup-logo-u" href="images/branding/pixel-lup.svg#letter-u" />
    <use class="lup-logo-p" href="images/branding/pixel-lup.svg#letter-p" />
</svg>

@code {
    [Parameter] public bool Animate { get; set; } = true;
    [Parameter] public bool Loop { get; set; }
}
