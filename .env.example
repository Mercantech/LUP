POSTGRES_USER=mercantec
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mercantec
CONNECTION_STRING=Host=mercantec-tech-db;Port=5432;Database=mercantec;Username=mercantec;Password=change-me
CORS_SPA_ORIGINS=https://mercantec.tech;https://lup.dk;https://www.lup.dk;http://localhost:3000
# Non-secret allowlist. Upload keys are issued after Mercantec Auth; never put them here.
EXTENSION_UPLOAD_ALLOWED_EMAILS=mags@mercantec.dk;kasc@mercantec.dk
EXTENSION_UPLOAD_ALLOWED_SUBJECTS=d969fced-f7be-46d4-9bb9-5a2f03ca6974
AUTH_ISSUER=https://auth.mercantec.tech
AUTH_AUDIENCE=mercantec-apps
LUP_MCP_PUBLIC_URL=https://lup.dk/api/mcp
JWKS_URI=https://auth.mercantec.tech/.well-known/jwks.json
Lectio__BaseUrl=https://lc.mags.dk/api/

# Produktion bruger 10.251.90.0/24 som standard. Sæt et unikt subnet ved ekstra stacks på samme Docker-vært.
# Det lokale Compose-overlay bruger automatisk tildeling, når værdien er tom.
LUP_PRIVATE_SUBNET=
# Hæv de to prioriteter for produktion, hvis en anden stack også har disse Host-regler.
LUP_TRAEFIK_PRIORITY=100
LUP_GAMES_REDIRECT_PRIORITY=10000

# MinIO/Silo (S3-kompatibel object storage) — aldrig commit rigtige credentials
# Compose bruger image pgsty/silo (quay.io/minio/* giver 401)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_BUCKET=mercantec-tech
OBJECT_STORAGE_ENDPOINT=http://mercantec-tech-minio:9000
# Lokal browser-adgang til S3. Produktionsoverlayet bruger LUPs API til filadgang.
OBJECT_STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:9000
# Admin UI (Console): lokalt http://localhost:9001 med docker-compose.local.yml
# Produktion kræver docker-compose.production.yml og begge MINIO_ROOT-værdier.
# Brug stærke credentials i Dokploy. MinIO er kun tilgængelig på det private net.
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001

# Valgfri isoleret HTTPS-origin til HTML-, Unity- og Godot-webbuilds.
# Tom værdi slår spilafvikling fra. DNS og reverse proxy skal sættes op særskilt.
# Upload, validering og LUPP-oplåsning fungerer også uden forhåndsvisningsdomænet.
# Send preview-domænet direkte til API'et med bevaret HTTPS/Host og en betroet proxy-IP.
# Webcontainerens HTTP-nginx på port 3000 må ikke omskrive preview-HTTPS til http.
WEB_PREVIEW_ORIGIN=
WEB_PREVIEW_APP_ORIGIN=https://mercantec.tech
# Semikolonseparerede IP-adresser på betroede reverse proxies til HTTPS/Host-headere.
REVERSE_PROXY_KNOWN_PROXIES=

# Optional override; blank uses the automatically generated persistent service key.
# At least 32 random characters when set. Never commit real credentials.
NOTION_SERVICE_SECRET=

# Microsoft Graph — underviserkalender (samme app som Plan; Calendars.Read application)
# Aldrig commit rigtige credentials — sæt i Dokploy / lokal .env
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Hjem.exe. Forbind til en separat HTTPS-kodearbejder. Aktiveres først for elever ved udgivelse.
HOME_GAME_ENABLED=false
HOME_GAME_RUNNER_URL=
HOME_GAME_RUNNER_TOKEN=
# SHA-256 of the worker certificate in DER format, as 64 hex digits. Leave empty for public CA trust.
HOME_GAME_RUNNER_CERT_SHA256=
HOME_GAME_CONTROL_NETWORK=lup-home-runner-control
HOME_GAME_WORKER_SLOTS=8
# Valgfri Auth sub/e-mail → Azure UPN (Mathias/Kasper er default i compose)
# AZURE_TEACHER_UPN_MAP=d969fced-f7be-46d4-9bb9-5a2f03ca6974=mags@mercantec.dk;mathiasgsteenberg@gmail.com=mags@mercantec.dk;kasc@mercantec.dk=kasc@mercantec.dk
